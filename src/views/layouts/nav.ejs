<!-- Navigation Bar -->
<%
  // Destinations, labels, visibility and the current page all come from
  // src/config/navigation.js (exposed as app.locals.buildNavigation). This template
  // only renders them; add or change nav links in that config, not here.
  // Outside Express (e.g. a view rendered directly in a unit test) the builder is
  // absent and only the logo bar is rendered; server.js always provides it.
  const navigation = typeof locals.buildNavigation === 'function'
    ? locals.buildNavigation(locals)
    : { primary: [], account: [], auth: [], workspaceSwitch: null, bottom: null, isRunnerWorkspace: false };
  const headerClass = (item) => `nav-icon-link${item.className ? ` ${item.className}` : ''}${item.isCurrent ? ' is-active' : ''}`;
%>
<nav class="nav" aria-label="Main navigation">
  <div class="nav-container">
    <a href="/" class="logo" aria-label="HelloRun Home">
      <img src="/images/helloRun-icon.webp" alt="" class="logo-icon">
      <span>HelloRun</span>
    </a>

    <% if (locals.renderRunProofModal && (!locals.isAuthenticated || navigation.isRunnerWorkspace)) { %>
      <div class="nav-run-proof-action">
        <span class="nav-run-proof-callout" data-nav-run-proof-callout aria-hidden="true">
          <span class="nav-run-proof-callout-kicker">Run proof</span>
          <span class="nav-run-proof-callout-text">Submit your recorded run here</span>
        </span>
        <button
          class="nav-run-proof-shortcut"
          type="button"
          data-open-run-proof-modal
          aria-label="Log latest run"
          title="Log latest run">
          <i data-lucide="plus-circle"></i>
        </button>
      </div>
    <% } %>

    <button
      class="menu-toggle"
      type="button"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="nav-links"
      aria-haspopup="true">
      <i data-lucide="menu"></i>
    </button>

    <div class="nav-links" id="nav-links">
      <% navigation.primary.forEach((item) => { %>
        <%- include('nav-item', { item, itemClass: headerClass(item) }) %>
      <% }) %>
      <%# Hidden by pwa.css until /js/pwa.js finds a real install path (Chromium prompt or iOS guidance). %>
      <button type="button" class="nav-icon-link nav-install-btn" data-pwa-install-action aria-label="Install HelloRun" title="Install HelloRun">
        <i data-lucide="download" aria-hidden="true"></i>
        <span class="nav-tooltip">Install HelloRun</span>
      </button>

      <% if (locals.isAuthenticated) { %>
        <% navigation.account.forEach((item) => { %>
          <%- include('nav-item', { item, itemClass: headerClass(item) }) %>
        <% }) %>
        <% if (navigation.workspaceSwitch) { %>
          <form action="<%= navigation.workspaceSwitch.action %>" method="POST" class="workspace-switch-form">
            <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
            <button type="submit" class="nav-icon-link" aria-label="<%= navigation.workspaceSwitch.label %>" title="<%= navigation.workspaceSwitch.label %>"><i data-lucide="<%= navigation.workspaceSwitch.icon %>" aria-hidden="true"></i><span class="nav-tooltip"><%= navigation.workspaceSwitch.tooltip %></span></button>
          </form>
        <% } %>

        <div class="nav-user">
          <% if (locals.user && locals.user.avatarUrl) { %>
            <img src="<%= locals.user.avatarUrl %>" alt="" class="nav-avatar" aria-hidden="true">
          <% } %>
          <span class="nav-username">Hi, <%= locals.user ? locals.user.firstName : 'User' %></span>
          <form action="/logout" method="POST" class="logout-form">
            <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
            <button type="submit" class="nav-logout-btn nav-icon-link" aria-label="Log out of HelloRun" title="Log out">
              <i data-lucide="log-out" aria-hidden="true"></i>
              <span class="nav-tooltip">Log out</span>
            </button>
          </form>
        </div>
      <% } else { %>
        <div class="nav-auth-buttons">
          <% navigation.auth.forEach((item) => { %>
            <%- include('nav-item', { item, itemClass: headerClass(item) }) %>
          <% }) %>
        </div>
      <% } %>
    </div>
  </div>
</nav>
<% if (locals.flash && locals.flash.message) { %>
  <div class="global-flash global-flash-<%= locals.flash.type %>" role="<%= locals.flash.type === 'error' ? 'alert' : 'status' %>" data-global-flash>
    <span><%= locals.flash.message %></span>
    <button type="button" aria-label="Dismiss message" data-dismiss-global-flash><i data-lucide="x" aria-hidden="true"></i></button>
  </div>
<% } %>
<% if (navigation.bottom) { %>
<nav class="mobile-bottom-nav" aria-label="<%= navigation.bottom.label %>">
  <% navigation.bottom.items.forEach((item) => { %>
    <% if (item.kind === 'submit' && item.opensModal) { %>
      <button type="button" class="mobile-nav-tab mobile-nav-tab-submit" data-open-run-proof-modal data-run-proof-surface="runner-mobile-nav" aria-label="<%= item.ariaLabel %>"><i data-lucide="<%= item.icon %>" aria-hidden="true"></i><span><%= item.shortLabel %></span></button>
    <% } else if (item.kind === 'submit') { %>
      <a href="<%= item.href %>" class="mobile-nav-tab mobile-nav-tab-submit" aria-label="<%= item.ariaLabel %>"><i data-lucide="<%= item.icon %>" aria-hidden="true"></i><span><%= item.shortLabel %></span></a>
    <% } else { %>
      <a href="<%= item.href %>" class="mobile-nav-tab<%= item.isCurrent ? ' is-active' : '' %>" aria-label="<%= item.ariaLabel %>"<% if (item.isCurrent) { %> aria-current="page"<% } %>><i data-lucide="<%= item.icon %>" aria-hidden="true"></i><span><%= item.shortLabel %></span></a>
    <% } %>
  <% }) %>
</nav>
<% } %>
