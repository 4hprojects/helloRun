<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'HelloRun - Virtual Running Events' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Poppins:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/design-system.css">
  <link rel="stylesheet" href="/css/ads.css">
  <link rel="stylesheet" href="/css/cookie-preferences.css">
  <% if (locals.additionalCSS) { %>
    <% additionalCSS.forEach(css => { %>
      <link rel="stylesheet" href="<%= css %>">
    <% }); %>
  <% } %>
  <link rel="stylesheet" href="/css/project-buttons.css">
  <script nonce="<%= locals.cspNonce || String() %>" src="/js/vendor/lucide/lucide.min.js"></script>
  <%- include('../partials/privacy-head') %>
  <% if (locals.ads && locals.ads.loadConsentScript && locals.ads.publisherId) { %>
  <script nonce="<%= locals.cspNonce || String() %>" async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=<%= locals.ads.publisherId %>" crossorigin="anonymous"></script>
  <% } %>
  
  <!-- Google Analytics -->
  <% if (locals.canUseAnalytics && process.env.GA_MEASUREMENT_ID) { %>
  <script nonce="<%= locals.cspNonce || String() %>" async src="https://www.googletagmanager.com/gtag/js?id=<%= process.env.GA_MEASUREMENT_ID %>"></script>
  <script nonce="<%= locals.cspNonce || String() %>">
    gtag('js', new Date());
    gtag('config', '<%= process.env.GA_MEASUREMENT_ID %>');
  </script>
  <% } %>
</head>
<body>
  <%- include('./nav') %>
  
  <main>
    <%- body %>
  </main>
  
  <%- include('./footer') %>
  
  <script nonce="<%= locals.cspNonce || String() %>" src="/js/main.js"></script>
  <% if (locals.additionalJS) { %>
    <% additionalJS.forEach(js => { %>
      <script nonce="<%= locals.cspNonce || String() %>" src="<%= js %>"></script>
    <% }); %>
  <% } %>
  
  <script nonce="<%= locals.cspNonce || String() %>">
    lucide.createIcons();
  </script>
</body>
</html>
