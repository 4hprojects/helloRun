<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../layouts/head', { title: title }) %>
  <link rel="stylesheet" href="/css/organizer-events.css">
  <link rel="stylesheet" href="/css/organizer-check-in.css">
</head>
<body>
  <%- include('../layouts/nav') %>

  <main class="checkin-page" id="main-content" data-registrant-import data-event-id="<%= eventId %>" data-csrf="<%= locals.csrfToken || '' %>">
    <div class="checkin-shell">
      <header class="checkin-header">
        <div>
          <p class="checkin-kicker">Import registrants</p>
          <h1><%= event.title %></h1>
        </div>
        <nav class="checkin-header-actions" aria-label="Onsite actions">
          <a href="/organizer/events/<%= eventId %>/registrants" class="nav-login-btn">Registrants</a>
          <a href="/organizer/events/<%= eventId %>" class="nav-login-btn">Back to event</a>
        </nav>
      </header>

      <section class="checkin-scanner" aria-labelledby="importFileTitle">
        <h2 id="importFileTitle">Choose a file</h2>
        <p class="checkin-note">
          A <code>.csv</code> or <code>.xlsx</code> with first name, last name, email and
          contact number columns. Participation mode and emergency contact are used when
          present. Other columns are ignored. Nothing is created until you confirm.
        </p>
        <p class="checkin-note">
          <% if ((event.raceDistances || []).filter(Boolean).length === 1) { %>
            This event has one category, <strong><%= (event.raceDistances || []).filter(Boolean)[0] %></strong>,
            so a category column is optional — rows without one are entered into it.
          <% } else { %>
            This event does not have a single category to fall back on, so each row needs a
            category column. Rows without one are rejected rather than entered into a
            distance nobody chose.
          <% } %>
        </p>
        <p class="checkin-note">
          For an onsite event, each row also needs an emergency contact name and number.
          That requirement is not waived for imports — someone has to be reachable if a
          participant gets hurt — so add those columns before importing.
        </p>
        <div class="checkin-search-row">
          <label class="visually-hidden" for="registrantsFile">Registrant list</label>
          <input id="registrantsFile" type="file" accept=".csv,.xlsx,.xls" data-import-file>
          <button type="button" class="nav-signup-btn" data-import-preview>Check file</button>
        </div>
        <p class="checkin-scan-result" role="status" aria-live="polite" data-import-status></p>
      </section>

      <section class="checkin-scanner" aria-labelledby="importPreviewTitle" data-import-preview-panel hidden>
        <h2 id="importPreviewTitle">Preview</h2>
        <div class="checkin-counts" aria-label="Import preview totals">
          <p class="checkin-count"><span class="checkin-count-value" data-import-ready>0</span><span class="checkin-count-label">Ready</span></p>
          <p class="checkin-count"><span class="checkin-count-value" data-import-rejected>0</span><span class="checkin-count-label">Rejected</span></p>
          <p class="checkin-count"><span class="checkin-count-value" data-import-total>0</span><span class="checkin-count-label">Rows read</span></p>
        </div>

        <p class="checkin-alert" data-import-truncated hidden role="alert"></p>
        <p class="checkin-note" data-import-unmapped hidden></p>
        <div class="checkin-bulk-result" data-import-errors hidden></div>
        <p><a data-import-error-download hidden download="registrant-import-errors.csv" href="#">Download the rejected rows</a></p>

        <label class="checkin-walkin-check">
          <input type="checkbox" data-import-send-emails>
          <span>Email each person their confirmation and private link</span>
        </label>
        <p class="checkin-note">
          Off by default. A large import would otherwise send hundreds of emails at once,
          against a daily allowance shared with password resets and payment notices.
          Without it, people can still claim their registration by signing up with the same
          email address.
        </p>

        <button type="button" class="nav-signup-btn" data-import-commit>Import the ready rows</button>
        <p class="checkin-scan-result" role="status" aria-live="polite" data-import-commit-status></p>
      </section>
    </div>
  </main>

  <%- include('../layouts/footer') %>
  <script src="/js/main.js"></script>
  <script src="/js/organizer-registrant-import.js"></script>
</body>
</html>
