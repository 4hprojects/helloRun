<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../layouts/head', { title: title }) %>
  <link rel="stylesheet" href="/css/organizer-events.css">
  <link rel="stylesheet" href="/css/run-proof-review.css">
  <link rel="stylesheet" href="/css/registrant-submissions.css">
  <%# Without JavaScript the dialogs cannot open, so show their forms inline instead of losing them. %>
  <noscript><style>
    .registrant-submissions-page .rs-dialog { display: block !important; position: static; width: auto; max-width: none; margin: 0.75rem 0 0; border: 1px solid #e2e8f0; box-shadow: none; grid-column: 1 / -1; }
    .registrant-submissions-page .rs-dialog-close, .registrant-submissions-page .rs-dialog-footer [data-close-dialog] { display: none !important; }
  </style></noscript>
</head>
<body>
  <%- include('../layouts/nav') %>

  <%
    const runTypeOptions = [
      ['run', 'Run'],
      ['walk', 'Walk'],
      ['hike', 'Hike'],
      ['trail_run', 'Trail run'],
      ['treadmill', 'Treadmill']
    ];
    const todayKey = new Date().toISOString().slice(0, 10);
    const summaryTiles = [
      { key: 'total', label: 'All entries', count: counts.total },
      { key: 'pending', label: 'Awaiting review', count: counts.pending },
      { key: 'approved', label: 'Approved', count: counts.approved },
      { key: 'rejected', label: 'Rejected', count: counts.rejected }
    ];
  %>

  <main class="events-page organizer-registrants-page run-proof-review-page registrant-submissions-page">
    <section class="events-shell">
      <header class="events-header rpr-header">
        <div class="rpr-heading">
          <p class="rpr-eyebrow"><%= event.title %></p>
          <h1><%= runner.name %></h1>
          <p class="rpr-subtitle">
            <%= runner.email %>
            <% if (runner.confirmationCode) { %> · <span class="rs-code"><%= runner.confirmationCode %></span><% } %>
            · <%= runner.categoryLabel %>
          </p>
        </div>
        <div class="header-actions run-proof-header-actions" aria-label="Runner submissions navigation">
          <a href="<%= links.registrants %>" class="rpr-btn rpr-btn-secondary">
            <i data-lucide="arrow-left" aria-hidden="true"></i><span>Registrants</span>
          </a>
          <a href="<%= links.queue %>" class="rpr-btn rpr-btn-secondary">
            <i data-lucide="scan-search" aria-hidden="true"></i><span>Run proof queue</span>
          </a>
        </div>
      </header>

      <% if (message) { %>
        <div class="page-message page-message-<%= message.type %>" role="status"><%= message.text %></div>
      <% } %>

      <div class="registrant-summary rpr-tabs rs-summary" role="group" aria-label="Entry totals">
        <% summaryTiles.forEach((tile) => { %>
          <div class="summary-card rpr-tab rpr-tab-<%= tile.key %>">
            <span class="rpr-tab-label"><%= tile.label %></span>
            <strong class="rpr-tab-count"><%= tile.count %></strong>
          </div>
        <% }) %>
      </div>

      <% if (entries.length) { %>
        <div class="results-meta run-proof-results-meta">
          <span><strong><%= entries.length %></strong> entr<%= entries.length === 1 ? 'y' : 'ies' %>, newest first. Corrections notify the runner and are recorded in the audit log.</span>
        </div>

        <section class="run-proof-review-list" aria-label="Runner entries">
          <% entries.forEach((item, index) => { %>
            <% const formId = `edit-entry-${item.id}`; %>
            <article class="run-proof-review-card rpr-card" id="entry-<%= item.id %>">
              <div class="rpr-media">
                <% if (item.proofUrl && item.isImageProof) { %>
                  <a href="<%= item.proofUrl %>" target="_blank" rel="noopener noreferrer" class="run-proof-image-link" aria-label="Open run proof image, entry <%= entries.length - index %>">
                    <img src="<%= item.proofUrl %>" alt="Run proof for entry <%= entries.length - index %>" loading="lazy" decoding="async">
                  </a>
                <% } else if (item.proofUrl) { %>
                  <a href="<%= item.proofUrl %>" target="_blank" rel="noopener noreferrer" class="rpr-media-fallback" aria-label="Open run proof file, entry <%= entries.length - index %>">
                    <i data-lucide="file-text" aria-hidden="true"></i>
                    <span>Proof file</span>
                  </a>
                <% } else { %>
                  <div class="rpr-media-fallback rpr-media-missing" role="img" aria-label="No run proof file is available for this entry">
                    <i data-lucide="image-off" aria-hidden="true"></i>
                    <span>No proof</span>
                  </div>
                <% } %>
              </div>

              <div class="run-proof-card-header rpr-card-head">
                <div class="rpr-identity">
                  <h2>Entry <%= entries.length - index %> · <%= item.submissionTypeLabel %></h2>
                  <p>Submitted <%= item.submittedAtLabel || 'N/A' %></p>
                </div>
                <div class="rpr-status">
                  <span class="status-badge status-badge-<%= item.statusClass %>"><%= item.statusLabel %></span>
                  <% if (item.passedSystemChecks) { %><span class="mode-badge mode-passed-checks" title="Validation passed; awaiting your review">Passed system checks</span><% } %>
                  <% if (item.corrections.length) { %><span class="rs-corrected-badge">Corrected<% if (item.corrections.length > 1) { %> ×<%= item.corrections.length %><% } %></span><% } %>
                  <% if (item.isOwnSubmission) { %><span class="run-proof-self-badge" title="Editing your own entry is recorded in the audit log">Your own entry</span><% } %>
                </div>
              </div>

              <div class="rpr-card-body">
                <% if (item.suspiciousFlag || item.reviewSignal?.label || item.hasOcrMismatch) { %>
                  <ul class="rpr-signals" aria-label="Validation signals">
                    <% if (item.suspiciousFlag || item.reviewSignal?.label) { %>
                      <li>
                        <i data-lucide="triangle-alert" aria-hidden="true"></i>
                        <span><strong><%= item.reviewSignal?.label || 'Suspicious' %></strong> <%= item.reviewSignal?.description || item.suspiciousFlagReason || 'This submission was flagged for manual review.' %></span>
                      </li>
                    <% } %>
                    <% if (item.hasOcrMismatch) { %>
                      <li>
                        <i data-lucide="scan-text" aria-hidden="true"></i>
                        <span><strong>OCR mismatch</strong> A value read from the proof image does not match what was entered. Check the proof carefully.</span>
                      </li>
                    <% } %>
                  </ul>
                <% } %>

                <dl class="run-proof-meta-grid">
                  <div><dt>Distance</dt><dd><%= item.distanceLabel %></dd></div>
                  <div><dt>Elapsed</dt><dd><%= item.elapsedLabel %></dd></div>
                  <div><dt>Run Date</dt><dd><%= item.runDateLabel || 'N/A' %></dd></div>
                  <div><dt>Source</dt><dd><%= item.sourceLabel %></dd></div>
                </dl>
              </div>

              <div class="rpr-card-side">
                <div class="rs-actions">
                  <% const canDecide = item.decision.canApprove || item.decision.canReject || item.decision.canReverse; %>
                  <% if (canDecide) { %>
                    <div class="rs-decisions rs-action-group" data-rs-decisions hidden>
                      <h4 class="rs-group-label">Decision</h4>
                      <% if (item.decision.canApprove) { %>
                        <button type="button" class="rs-decision-btn rs-decision-approve" data-open-dialog="approve-<%= item.id %>">
                          <i data-lucide="check-circle" aria-hidden="true"></i><span><%= item.status === 'rejected' ? 'Approve instead' : 'Approve' %></span>
                        </button>
                      <% } %>
                      <% if (item.decision.canReject) { %>
                        <button type="button" class="rs-decision-btn rs-decision-reject" data-open-dialog="reject-<%= item.id %>">
                          <i data-lucide="x-circle" aria-hidden="true"></i><span>Reject</span>
                        </button>
                      <% } %>
                      <% if (item.decision.canReverse) { %>
                        <button type="button" class="rs-decision-btn rs-decision-reject" data-open-dialog="reverse-<%= item.id %>">
                          <i data-lucide="undo-2" aria-hidden="true"></i><span>Reject approval</span>
                        </button>
                      <% } %>
                    </div>
                  <% } %>

                  <div class="rs-action-group rs-action-group-manage">
                    <h4 class="rs-group-label">Manage</h4>
                    <button type="button" class="rs-btn-neutral" data-open-dialog="edit-<%= item.id %>" data-rs-js-only hidden>
                      <i data-lucide="pencil" aria-hidden="true"></i><span>Edit values</span>
                    </button>
                    <% if (item.corrections.length) { %>
                      <button type="button" class="rs-btn-neutral" data-open-dialog="history-<%= item.id %>" data-rs-js-only hidden>
                        <i data-lucide="history" aria-hidden="true"></i><span>Correction history (<%= item.corrections.length %>)</span>
                      </button>
                    <% } %>
                    <a href="<%= item.actionHref %>" class="rs-btn-neutral">
                      <i data-lucide="eye" aria-hidden="true"></i>
                      <span><%= item.status === 'submitted' || item.status === 'needs_clarification' ? 'Open Review' : 'View Details' %></span>
                    </a>
                    <% if (item.proofUrl) { %>
                      <a href="<%= item.proofUrl %>" target="_blank" rel="noopener noreferrer" class="rpr-proof-link">
                        <i data-lucide="external-link" aria-hidden="true"></i>
                        Open proof
                      </a>
                    <% } %>
                  </div>
                </div>

                <% if (item.status !== 'submitted') { %>
                  <div class="run-proof-history">
                    <strong><%= item.isAutoApproved ? 'Approval History' : 'Review History' %></strong>
                    <p><%= item.isAutoApproved ? 'Approved' : 'Reviewed' %>: <%= item.reviewedAtLabel || 'N/A' %></p>
                    <% if (item.reviewerName) { %>
                      <p>By: <%= item.reviewerName %></p>
                    <% } else if (item.isAutoApproved) { %>
                      <p>By: Auto-validation rules</p>
                    <% } %>
                    <% if (item.rejectionReason) { %>
                      <p><strong>Reason:</strong> <%= item.rejectionReason %></p>
                    <% } %>
                    <% if (item.reviewNotes) { %>
                      <p><strong>Notes:</strong> <%= item.reviewNotes %></p>
                    <% } %>
                  </div>
                <% } %>
              </div>

              <dialog class="rs-dialog rs-dialog-wide" id="edit-<%= item.id %>" aria-labelledby="edit-<%= item.id %>-title">
                <form method="POST" action="<%= item.editAction %>" class="rs-dialog-form">
                  <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
                  <header class="rs-dialog-header">
                    <h3 id="edit-<%= item.id %>-title">Edit entry <%= entries.length - index %> values</h3>
                    <button type="button" class="rs-dialog-close" data-close-dialog aria-label="Close">&times;</button>
                  </header>

                  <div class="rs-edit-fields">
                    <div class="rs-field">
                      <label for="<%= formId %>-distance">Distance (km)</label>
                      <input id="<%= formId %>-distance" name="distanceKm" type="number" inputmode="decimal" step="0.01" min="0.1" max="500" value="<%= item.edit.distanceKm %>">
                    </div>

                    <fieldset class="rs-field rs-field-time">
                      <legend>Elapsed time</legend>
                      <div class="rs-time-inputs">
                        <label for="<%= formId %>-hours"><span>Hours</span>
                          <input id="<%= formId %>-hours" name="elapsedHours" type="number" inputmode="numeric" min="0" max="168" step="1" value="<%= item.edit.hours %>">
                        </label>
                        <label for="<%= formId %>-minutes"><span>Minutes</span>
                          <input id="<%= formId %>-minutes" name="elapsedMinutes" type="number" inputmode="numeric" min="0" max="59" step="1" value="<%= item.edit.minutes %>">
                        </label>
                        <label for="<%= formId %>-seconds"><span>Seconds</span>
                          <input id="<%= formId %>-seconds" name="elapsedSeconds" type="number" inputmode="numeric" min="0" max="59" step="1" value="<%= item.edit.seconds %>">
                        </label>
                      </div>
                    </fieldset>

                    <div class="rs-field">
                      <label for="<%= formId %>-date">Run date</label>
                      <input id="<%= formId %>-date" name="runDate" type="date" max="<%= todayKey %>" value="<%= item.edit.runDate %>">
                    </div>

                    <div class="rs-field">
                      <label for="<%= formId %>-type">Activity type</label>
                      <select id="<%= formId %>-type" name="runType">
                        <% runTypeOptions.forEach(([value, label]) => { %>
                          <option value="<%= value %>" <%= item.edit.runType === value ? 'selected' : '' %>><%= label %></option>
                        <% }) %>
                      </select>
                    </div>

                    <div class="rs-field rs-field-wide">
                      <label for="<%= formId %>-location">Location</label>
                      <input id="<%= formId %>-location" name="runLocation" type="text" maxlength="200" value="<%= item.edit.runLocation %>">
                    </div>

                    <div class="rs-field rs-field-wide">
                      <label for="<%= formId %>-reason">Reason for the correction <span class="rs-required">(required)</span></label>
                      <textarea id="<%= formId %>-reason" name="reason" rows="2" minlength="5" maxlength="500" required placeholder="Shown to the runner and recorded in the audit log"></textarea>
                    </div>
                  </div>

                  <p class="rs-note">
                    <i data-lucide="bell" aria-hidden="true"></i>
                    <span>The runner is notified by email and in-app.
                    <% if (item.status === 'approved') { %>Because this entry is approved, its ranking<%= item.submissionKind === 'accumulated' ? ' and challenge progress' : ' and certificate' %> will be recalculated.<% } %></span>
                  </p>

                  <footer class="rs-dialog-footer">
                    <button type="button" class="rs-btn-neutral" data-close-dialog>Cancel</button>
                    <button type="submit" class="rpr-btn rpr-btn-primary">
                      <i data-lucide="save" aria-hidden="true"></i><span>Save correction</span>
                    </button>
                  </footer>
                </form>
              </dialog>

              <% if (item.corrections.length) { %>
                <dialog class="rs-dialog" id="history-<%= item.id %>" aria-labelledby="history-<%= item.id %>-title">
                  <div class="rs-dialog-form">
                    <header class="rs-dialog-header">
                      <h3 id="history-<%= item.id %>-title">Correction history, entry <%= entries.length - index %></h3>
                      <button type="button" class="rs-dialog-close" data-close-dialog aria-label="Close">&times;</button>
                    </header>
                    <ol class="rs-history-list">
                      <% item.corrections.forEach((entry) => { %>
                        <li>
                          <p class="rs-history-meta"><strong><%= entry.editorName %></strong> · <%= entry.editedAtLabel %></p>
                          <ul>
                            <% entry.lines.forEach((line) => { %><li><%= line %></li><% }) %>
                          </ul>
                          <p class="rs-history-reason">Reason: <%= entry.reason %></p>
                        </li>
                      <% }) %>
                    </ol>
                    <footer class="rs-dialog-footer">
                      <button type="button" class="rs-btn-neutral" data-close-dialog>Close</button>
                    </footer>
                  </div>
                </dialog>
              <% } %>

              <% if (item.decision.canApprove) { %>
                <dialog class="rs-dialog" id="approve-<%= item.id %>" aria-labelledby="approve-<%= item.id %>-title">
                  <form method="POST" action="<%= item.decisionAction %>" class="rs-dialog-form">
                    <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
                    <input type="hidden" name="action" value="approve">
                    <input type="hidden" name="checklistVersion" value="<%= reviewChecklistVersion %>">
                    <header class="rs-dialog-header">
                      <h3 id="approve-<%= item.id %>-title">Approve entry <%= entries.length - index %></h3>
                      <button type="button" class="rs-dialog-close" data-close-dialog aria-label="Close">&times;</button>
                    </header>
                    <p class="rs-dialog-lead"><%= item.distanceLabel %> in <%= item.elapsedLabel %> on <%= item.runDateLabel || 'an unlisted date' %>.<% if (item.status === 'rejected') { %> This entry was rejected; approving it restores it and the runner is notified.<% } %></p>
                    <fieldset class="rs-checklist">
                      <legend>Required verification checklist</legend>
                      <p>Confirm every applicable item against the proof before approving.</p>
                      <% item.verificationCriteria.forEach((criterion) => { %>
                        <label class="rs-check-item"><input type="checkbox" name="verifiedCriteria" value="<%= criterion.key %>" required><span><%= criterion.label %></span></label>
                      <% }) %>
                    </fieldset>
                    <div class="rs-field">
                      <label for="approve-<%= item.id %>-notes">Review note <span class="rs-required">(optional, visible to the runner)</span></label>
                      <textarea id="approve-<%= item.id %>-notes" name="reviewNotes" rows="2" maxlength="1200"></textarea>
                    </div>
                    <footer class="rs-dialog-footer">
                      <button type="button" class="rs-btn-neutral" data-close-dialog>Cancel</button>
                      <button type="submit" class="rpr-btn rs-btn-approve"><i data-lucide="check-circle" aria-hidden="true"></i><span>Approve entry</span></button>
                    </footer>
                  </form>
                </dialog>
              <% } %>

              <% if (item.decision.canReject) { %>
                <dialog class="rs-dialog" id="reject-<%= item.id %>" aria-labelledby="reject-<%= item.id %>-title">
                  <form method="POST" action="<%= item.decisionAction %>" class="rs-dialog-form">
                    <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
                    <input type="hidden" name="action" value="reject">
                    <header class="rs-dialog-header">
                      <h3 id="reject-<%= item.id %>-title">Reject entry <%= entries.length - index %></h3>
                      <button type="button" class="rs-dialog-close" data-close-dialog aria-label="Close">&times;</button>
                    </header>
                    <p class="rs-dialog-lead">The runner is told why and can submit a corrected entry.</p>
                    <div class="rs-field">
                      <label for="reject-<%= item.id %>-code">Reason</label>
                      <select id="reject-<%= item.id %>-code" name="rejectionCode" required data-reject-code>
                        <option value="">Select the issue…</option>
                        <% item.rejectionOptions.forEach((reason) => { %>
                          <option value="<%= reason.code %>" data-default-message="<%= reason.defaultMessage %>"><%= reason.label %></option>
                        <% }) %>
                      </select>
                    </div>
                    <div class="rs-field">
                      <div class="rs-label-row">
                        <label for="reject-<%= item.id %>-message">Message to the runner</label>
                        <button type="button" class="rs-link-btn" data-use-suggested>Use suggested message</button>
                      </div>
                      <textarea id="reject-<%= item.id %>-message" name="rejectionReason" rows="4" maxlength="500" required data-reject-message></textarea>
                      <small class="rs-hint">Editable guidance. &ldquo;Other&rdquo; needs at least 10 characters of your own.</small>
                    </div>
                    <div class="rs-field">
                      <label for="reject-<%= item.id %>-notes">Review note <span class="rs-required">(optional, also visible to the runner)</span></label>
                      <textarea id="reject-<%= item.id %>-notes" name="reviewNotes" rows="2" maxlength="1200"></textarea>
                    </div>
                    <footer class="rs-dialog-footer">
                      <button type="button" class="rs-btn-neutral" data-close-dialog>Cancel</button>
                      <button type="submit" class="rpr-btn rs-btn-reject"><i data-lucide="x-circle" aria-hidden="true"></i><span>Reject entry</span></button>
                    </footer>
                  </form>
                </dialog>
              <% } %>

              <% if (item.decision.canReverse) { %>
                <dialog class="rs-dialog" id="reverse-<%= item.id %>" aria-labelledby="reverse-<%= item.id %>-title">
                  <form method="POST" action="<%= item.decisionAction %>" class="rs-dialog-form">
                    <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
                    <input type="hidden" name="action" value="reverse">
                    <header class="rs-dialog-header">
                      <h3 id="reverse-<%= item.id %>-title">Reject approval of entry <%= entries.length - index %></h3>
                      <button type="button" class="rs-dialog-close" data-close-dialog aria-label="Close">&times;</button>
                    </header>
                    <div class="rs-consequences" role="note">
                      <strong>This entry is approved, so rejecting it also:</strong>
                      <ul>
                        <li>revokes any certificate issued for it</li>
                        <li>withdraws badges earned from it and removes its ranking</li>
                        <li>tells the runner the approved result was withdrawn</li>
                      </ul>
                    </div>
                    <div class="rs-field">
                      <label for="reverse-<%= item.id %>-code">Reason <span class="rs-required">(shared with the runner and recorded in the audit log)</span></label>
                      <select id="reverse-<%= item.id %>-code" name="reversalCode" required data-reversal-code>
                        <option value="">Select the reason…</option>
                        <% (item.reversalOptions || []).forEach((reason) => { %>
                          <option value="<%= reason.code %>" data-label="<%= reason.label %>" data-guidance="<%= reason.guidance %>"><%= reason.label %></option>
                        <% }) %>
                      </select>
                    </div>
                    <div class="rs-field">
                      <label for="reverse-<%= item.id %>-note">Additional note <span class="rs-required">(optional, shared with the runner)</span></label>
                      <textarea id="reverse-<%= item.id %>-note" name="reversalNote" rows="3" maxlength="500" data-reversal-note></textarea>
                      <small class="rs-hint" data-reversal-hint>Leave blank to send the reason&rsquo;s standard guidance. &ldquo;Other&rdquo; needs at least 10 characters of your own.</small>
                    </div>
                    <div class="rs-preview" aria-live="polite">
                      <strong>What the runner will see</strong>
                      <p data-reversal-preview>Select a reason to preview the message.</p>
                    </div>
                    <footer class="rs-dialog-footer">
                      <button type="button" class="rs-btn-neutral" data-close-dialog>Cancel</button>
                      <button type="submit" class="rpr-btn rs-btn-reject"><i data-lucide="undo-2" aria-hidden="true"></i><span>Reject approval</span></button>
                    </footer>
                  </form>
                </dialog>
              <% } %>
            </article>
          <% }) %>
        </section>
      <% } else { %>
        <div class="empty-state rpr-empty">
          <i data-lucide="file-x" aria-hidden="true"></i>
          <h3>No entries yet</h3>
          <p><%= runner.name %> has not submitted any run proofs or activities for this event.</p>
          <a href="<%= links.registrants %>" class="rpr-btn rpr-btn-secondary">Back to registrants</a>
        </div>
      <% } %>
    </section>
  </main>

  <%- include('../layouts/footer') %>
  <script src="/js/main.js"></script>
  <script src="/js/registrant-submissions.js" defer></script>
  <script>if (window.lucide) lucide.createIcons();</script>
</body>
</html>
