<%
  const serverOcr = locals.serverOcr || null;
  const entry = locals.entry || {};
  const auto = serverOcr && serverOcr.autoApproval ? serverOcr.autoApproval : null;
  const statusLabel = {
    queued: 'Checking proof', processing: 'Checking proof', complete: 'Read',
    partial: 'Partly read', failed: 'Could not read', not_run: 'Not run'
  };
  const formatDuration = (ms) => {
    const total = Math.round(Number(ms) / 1000);
    if (!Number.isFinite(total) || total <= 0) return 'Not detected';
    const h = Math.floor(total / 3600);
    const m = Math.floor((total % 3600) / 60);
    const s = total % 60;
    return `${h > 0 ? `${h}h ` : ''}${m}m ${s}s`;
  };
  const formatDate = (value) => {
    if (!value) return 'Not detected';
    const parsed = new Date(value);
    return Number.isNaN(parsed.getTime()) ? String(value) : parsed.toISOString().slice(0, 10);
  };
  const originalValue = (field, current) => {
    for (const correction of entry.organizerCorrections || []) {
      const change = (correction.changes || []).find((item) => item.field === field);
      if (change) return change.from;
    }
    return current;
  };
  const rows = auto ? [
    { label: 'Distance', field: 'distanceKm', runner: originalValue('distanceKm', entry.distanceKm), server: auto.extractedDistanceKm, final: entry.distanceKm, mismatch: auto.distanceMismatch, format: (value) => value == null ? 'Not provided' : `${Number(value).toFixed(2)} km` },
    { label: 'Duration', field: 'elapsedMs', runner: originalValue('elapsedMs', entry.elapsedMs), server: auto.extractedTimeMs, final: entry.elapsedMs, mismatch: auto.timeMismatch, format: formatDuration },
    { label: 'Date', field: 'runDate', runner: originalValue('runDate', entry.runDate), server: auto.extractedRunDate, final: entry.runDate, mismatch: auto.dateMismatch, format: formatDate },
    { label: 'Activity type', field: 'runType', runner: originalValue('runType', entry.runType), server: auto.extractedRunType, final: entry.runType, mismatch: auto.runTypeMismatch, format: (value) => value ? String(value).replace(/_/g, ' ') : 'Not detected' },
    { label: 'Elevation', field: 'elevationGain', runner: originalValue('elevationGain', entry.elevationGain), server: auto.extractedElevationGain, final: entry.elevationGain, mismatch: auto.elevationMismatch, format: (value) => value == null ? 'Not provided' : `${Math.round(Number(value))} m` },
    { label: 'Steps', field: 'steps', runner: originalValue('steps', entry.steps), server: auto.extractedSteps, final: entry.steps, mismatch: auto.stepsMismatch, format: (value) => value == null ? 'Not provided' : Number(value).toLocaleString() },
    { label: 'Location', field: 'runLocation', runner: originalValue('runLocation', entry.runLocation), server: auto.extractedRunLocation, final: entry.runLocation, mismatch: auto.locationMismatch, format: (value) => value ? String(value) : 'Not provided' }
  ].filter((row) => row.runner != null || row.server != null || row.final != null) : [];
%>
<% if (serverOcr && serverOcr.status) { %>
  <section class="submission-review-section server-ocr-panel" aria-labelledby="server-ocr-heading">
    <h3 id="server-ocr-heading"><i data-lucide="scan-text"></i> HelloRun server reading comparison</h3>
    <p class="submission-review-muted"><%= statusLabel[serverOcr.status] || serverOcr.status %><% if (serverOcr.platform) { %> · detected app <strong><%= serverOcr.platform %></strong><% } %></p>
    <% if (rows.length) { %>
      <div class="proof-comparison" role="table" aria-label="Runner values, server reading, difference, and final reviewer values">
        <div class="proof-comparison-row proof-comparison-header" role="row"><span role="columnheader">Field</span><span role="columnheader">Runner confirmed</span><span role="columnheader">Server reading</span><span role="columnheader">Difference</span><span role="columnheader">Final value</span></div>
        <% rows.forEach((row) => { %><div class="proof-comparison-row <%= row.mismatch ? 'has-mismatch' : '' %>" role="row"><strong role="rowheader"><%= row.label %></strong><span><%= row.format(row.runner) %></span><span><%= row.format(row.server) %></span><span><%= row.mismatch ? 'differs from entry' : 'No flagged difference' %></span><span><%= row.format(row.final) %></span></div><% }) %>
      </div>
    <% } else if (serverOcr.status === 'failed') { %>
      <p>Screenshot could not be read. Review the original proof manually.</p>
    <% } else { %>
      <p>Server reading has no comparable values yet.</p>
    <% } %>
    <% if (serverOcr.errorCode) { %><p class="submission-review-muted">Processing reason: <%= serverOcr.errorCode %></p><% } %>
    <p class="submission-review-muted">Use the screenshot as final evidence. Detected values are reviewer support only.</p>
  </section>
<% } %>
