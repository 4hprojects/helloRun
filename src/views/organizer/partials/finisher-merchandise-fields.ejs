<% const finisherMerch = formData.finisherMerchandise || {}; %>
<div class="form-group form-group-full">
  <div class="subsection-divider">Finisher Merchandise (optional)</div>
  <input type="hidden" name="finisherMerchandiseSubmitted" value="1">
  <div class="toggle-section-label"><input type="checkbox" id="finisherMerchandiseEnabled" name="finisherMerchandiseEnabled" value="1" <%= finisherMerch.enabled ? 'checked' : '' %>><label for="finisherMerchandiseEnabled" class="toggle-label-text">Show a merchandise card for verified finishers</label></div>
  <small class="field-hint">Sold after verified completion, never during registration. It adds no package or price to sign-up.<% if (finisherMerch.imageCount) { %> <%= finisherMerch.imageCount %> product photo(s) are kept as configured.<% } %></small>
  <div class="form-grid">
    <div class="form-group">
      <label for="finisherMerchandiseName">Merchandise name</label>
      <input id="finisherMerchandiseName" name="finisherMerchandiseName" type="text" maxlength="100" value="<%= finisherMerch.name || '' %>" placeholder="Finisher Shirt + Medal Bundle">
    </div>
    <div class="form-group">
      <label for="finisherMerchandisePriceAmount">Price (PHP)</label>
      <input id="finisherMerchandisePriceAmount" name="finisherMerchandisePriceAmount" type="number" min="0" step="0.01" value="<%= finisherMerch.priceAmount ?? '' %>">
    </div>
    <div class="form-group">
      <label for="finisherMerchandiseShippingNote">Shipping note</label>
      <input id="finisherMerchandiseShippingNote" name="finisherMerchandiseShippingNote" type="text" maxlength="200" value="<%= finisherMerch.shippingNote || '' %>" placeholder="Free shipping within the Philippines.">
    </div>
    <div class="form-group">
      <label for="finisherMerchandiseOrderingState">Ordering</label>
      <select id="finisherMerchandiseOrderingState" name="finisherMerchandiseOrderingState">
        <option value="preview" <%= finisherMerch.orderingState !== 'open' ? 'selected' : '' %>>Preview only (no orders yet)</option>
        <option value="open" <%= finisherMerch.orderingState === 'open' ? 'selected' : '' %>>Open to verified finishers</option>
      </select>
    </div>
    <div class="form-group form-group-full">
      <label for="finisherMerchandiseDescription">Description</label>
      <textarea id="finisherMerchandiseDescription" name="finisherMerchandiseDescription" rows="2" maxlength="500"><%= finisherMerch.description || '' %></textarea>
    </div>
    <div class="form-group form-group-full">
      <label for="finisherMerchandisePreviewNote">Note while in preview</label>
      <textarea id="finisherMerchandisePreviewNote" name="finisherMerchandisePreviewNote" rows="2" maxlength="500"><%= finisherMerch.previewNote || '' %></textarea>
    </div>
    <div class="form-group form-group-full">
      <label for="finisherMerchandiseOpenNote">Note when ordering is open</label>
      <textarea id="finisherMerchandiseOpenNote" name="finisherMerchandiseOpenNote" rows="2" maxlength="500"><%= finisherMerch.openNote || '' %></textarea>
    </div>
  </div>
</div>
