<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../layouts/head', { title, seo }) %>
  <link rel="stylesheet" href="/css/leaderboard.css">
</head>
<body>
  <%- include('../layouts/nav') %>

  <% const event = leaderboard.event || {}; %>
  <% const settings = leaderboard.settings || {}; %>
  <% const filters = leaderboard.filters || {}; %>
  <% const activeDistance = leaderboard.activeDistance || {}; %>
  <% const standingView = presentation.standing || {}; %>
  <% const standing = standingView.entry || null; %>
  <% const overviewStats = presentation.overviewStats || {}; %>
  <% const recognitions = (presentation.recognitions || []).filter((item) => item.enabled); %>
  <% const isAccumulated = presentation.isAccumulated; %>
  <% const primaryMetric = ['steps', 'elevation', 'consistency'].includes(settings.primaryMetric) ? settings.primaryMetric : 'distance'; %>
  <% const primaryMetricLabel = primaryMetric === 'steps' ? 'Verified steps' : primaryMetric === 'elevation' ? 'Verified elevation gain' : primaryMetric === 'consistency' ? 'Active days' : 'Verified distance'; %>
  <% const officialPrimaryMetric = event.primaryChallengeMetric === 'steps' ? 'steps' : 'distance'; %>
  <% const isAlternateRanking = isAccumulated && primaryMetric !== officialPrimaryMetric; %>
  <% const rankingViewLabel = primaryMetric === 'elevation' ? 'Highest Elevation' : primaryMetric === 'consistency' ? 'Most Consistent' : primaryMetric === 'steps' ? 'Highest Steps' : 'Distance'; %>
  <% const goalMetric = ['elevation', 'consistency'].includes(primaryMetric) ? officialPrimaryMetric : primaryMetric; %>
  <% const challengeGoalLabel = goalMetric === 'steps' ? event.targetStepsLabel : event.targetDistanceLabel; %>
  <% const selectedGoalLabel = activeDistance.goalLabel || challengeGoalLabel; %>
  <main class="leaderboard-page">
    <div class="leaderboard-shell leaderboard-event-shell">
      <header class="leaderboard-event-header <%= isAccumulated ? 'leaderboard-challenge-header' : '' %>">
        <div class="leaderboard-event-identity">
          <a class="leaderboard-back-link" href="/events/<%= event.slug %>"><i data-lucide="arrow-left" aria-hidden="true"></i> Back to event</a>
          <% if (isAccumulated && event.logoUrl) { %><img src="<%= event.logoUrl %>" alt="" class="leaderboard-challenge-logo"><% } %>
          <p class="leaderboard-kicker"><%= settings.type === 'accumulated_challenge' ? 'Accumulated Challenge Leaderboard' : 'Race Result Leaderboard' %></p>
          <h1><%= event.title %></h1>
          <p><%= leaderboard.rankingExplanation %></p>
        </div>
        <dl class="leaderboard-event-summary">
          <% if (isAccumulated && presentation.showCategoryCards) { %>
            <div><dt>Current ranking</dt><dd><%= rankingViewLabel %></dd></div>
            <div><dt>Categories</dt><dd><%= overviewStats.categoryCount %> registration categories</dd></div>
            <div><dt>Official results</dt><dd><%= overviewStats.verifiedEntries %> verified across all categories</dd></div>
            <div><dt>Challenge window</dt><dd><%= event.dateLabel %></dd></div>
          <% } else if (isAccumulated) { %>
            <div><dt><%= isAlternateRanking ? 'Viewing ranking' : 'Official ranking' %></dt><dd><%= isAlternateRanking ? rankingViewLabel : primaryMetricLabel %></dd></div>
            <div><dt>Challenge goal</dt><dd><%= selectedGoalLabel %></dd></div>
            <div><dt>Challenge window</dt><dd><%= event.dateLabel %></dd></div>
            <div><dt>Official results</dt><dd><%= leaderboard.stats.verifiedEntries %> verified</dd></div>
            <div><dt>Last updated</dt><dd><%= leaderboard.stats.lastUpdatedAt ? new Date(leaderboard.stats.lastUpdatedAt).toLocaleString('en-US') : 'No results yet' %></dd></div>
          <% } else { %><div><dt>Viewing</dt><dd><%= activeDistance.label || 'All results' %></dd></div><% } %>
          <% if (!isAccumulated) { %>
            <div><dt>Official results</dt><dd><%= leaderboard.stats.verifiedEntries %> verified</dd></div>
            <div><dt>Last updated</dt><dd><%= leaderboard.stats.lastUpdatedAt ? new Date(leaderboard.stats.lastUpdatedAt).toLocaleString('en-US') : 'No results yet' %></dd></div>
          <% } %>
        </dl>
      </header>

      <% if (!presentation.showCategoryCards) { %>
        <%- include('_event-leaderboard-standing', { standingView, standing, isAccumulated, primaryMetricLabel, settings, primaryMetric, activeDistance }) %>
      <% } %>

      <% if (presentation.showCategoryCards) { %>
        <section class="leaderboard-category-overview" aria-labelledby="leaderboard-category-overview-title">
          <div class="leaderboard-section-heading">
            <div><p class="leaderboard-kicker">Progress toward each goal</p><h2 id="leaderboard-category-overview-title">Category Leaders</h2></div>
            <span><%= presentation.categoryCards.length %> categories</span>
          </div>
          <div class="leaderboard-category-grid">
            <% presentation.categoryCards.forEach((card) => { %>
              <article class="leaderboard-category-card <%= card.active ? 'is-active' : '' %>">
                <div class="leaderboard-category-card-head">
                  <div><p class="leaderboard-category-goal"><%= card.goalLabel %></p><h3><%= card.label %></h3></div>
                  <span class="leaderboard-category-count"><strong><%= card.stats.verifiedEntries %></strong> verified</span>
                </div>
                <% if (card.leaders.length) { %>
                  <ol class="leaderboard-category-leaders" aria-label="Top verified runners in <%= card.label %>">
                    <% card.leaders.forEach((leader) => { %>
                      <li class="leaderboard-rank-<%= leader.rank <= 3 ? leader.rank : 'standard' %>">
                        <span class="leaderboard-rank-badge">#<%= leader.rank %></span>
                        <span><strong><%= leader.runnerName %></strong><small><%= leader.primaryMetricLabel %></small></span>
                      </li>
                    <% }) %>
                  </ol>
                <% } else { %>
                  <div class="leaderboard-category-empty"><strong>No verified runners yet</strong><span>Official results will appear after organizer review.</span></div>
                <% } %>
                <a href="<%= card.href %>" class="leaderboard-button <%= card.active ? 'leaderboard-button-primary' : 'leaderboard-button-secondary' %> leaderboard-category-action" <%= card.active ? 'aria-current="page"' : '' %>>
                  <%= card.active ? 'Viewing full rankings' : 'View full rankings' %><i data-lucide="arrow-right" aria-hidden="true"></i>
                </a>
              </article>
            <% }) %>
          </div>
        </section>
      <% } %>

      <% if (recognitions.length) { %>
        <section class="leaderboard-recognition-overview" aria-labelledby="leaderboard-recognition-title">
          <div class="leaderboard-section-heading">
            <div><p class="leaderboard-kicker">Across all five categories</p><h2 id="leaderboard-recognition-title">Event-wide Recognition</h2></div>
            <span><%= recognitions.length %> awards</span>
          </div>
          <div class="leaderboard-recognition-grid">
            <% recognitions.forEach((recognition) => { %>
              <article class="leaderboard-recognition-card">
                <div class="leaderboard-recognition-icon" aria-hidden="true"><i data-lucide="<%= recognition.icon %>"></i></div>
                <div class="leaderboard-recognition-copy">
                  <h3><%= recognition.title %></h3>
                  <% if (recognition.state === 'populated') { %>
                    <p class="leaderboard-recognition-total"><strong><%= recognition.resultLabel %></strong> from approved results across all five categories.</p>
                    <ul class="leaderboard-recognition-leaders" aria-label="<%= recognition.title %> <%= recognition.leaders.length === 1 ? 'leader' : 'co-leaders' %>">
                      <% recognition.leaders.forEach((leader) => { %>
                        <li><strong><%= leader.runnerName %></strong><span><%= leader.categoryLabel %></span></li>
                      <% }) %>
                    </ul>
                  <% } else if (recognition.state === 'pre_event') { %>
                    <p class="leaderboard-recognition-empty">Recognition begins <%= recognition.startLabel %>. The overall leader will be determined from approved results across all five categories.</p>
                  <% } else { %>
                    <p class="leaderboard-recognition-empty"><%= recognition.emptyLabel %></p>
                  <% } %>
                </div>
                <% if (recognition.state === 'populated') { %>
                  <a href="<%= recognition.href %>" class="leaderboard-button leaderboard-button-secondary leaderboard-recognition-action">View <%= recognition.metric === 'consistency' ? 'consistency' : recognition.metric %> standings</a>
                <% } %>
              </article>
            <% }) %>
          </div>
        </section>
      <% } %>

      <% if (presentation.showMetricNavigation) { %>
        <nav class="leaderboard-distance-tabs" aria-label="Leaderboard metric">
          <% presentation.metricOptions.forEach((metric) => { %>
            <a href="<%= presentation.getMetricUrl(metric.key) %>" class="leaderboard-distance-tab <%= metric.active ? 'is-active' : '' %>" <%= metric.active ? 'aria-current="page"' : '' %>>
              <span><%= metric.label %></span>
            </a>
          <% }) %>
        </nav>
      <% } %>

      <% if (presentation.showCategoryCards) { %>
        <%- include('_event-leaderboard-standing', { standingView, standing, isAccumulated, primaryMetricLabel, settings, primaryMetric, activeDistance }) %>
      <% } %>

      <section class="leaderboard-result-controls" aria-labelledby="result-controls-title">
        <div class="leaderboard-results-toolbar">
          <div><p class="leaderboard-kicker"><%= leaderboard.isEventWideMetricView ? 'Event-wide recognition standings' : (isAccumulated ? `Goal: ${selectedGoalLabel}` : 'Official field') %></p><h2 id="result-controls-title"><%= activeDistance.label %> Rankings</h2><p><strong><%= leaderboard.stats.verifiedEntries %></strong> verified runner<%= leaderboard.stats.verifiedEntries === 1 ? '' : 's' %> ranked by <%= isAccumulated ? primaryMetricLabel.toLowerCase() : 'official result' %>.</p></div>
          <form method="GET" action="/events/<%= event.slug %>/leaderboard" class="leaderboard-runner-search" role="search">
            <% if (!leaderboard.isEventWideMetricView) { %><input type="hidden" name="distance" value="<%= activeDistance.key || '' %>"><% } %>
            <% if (filters.mode) { %><input type="hidden" name="mode" value="<%= filters.mode %>"><% } %>
            <% if (filters.status) { %><input type="hidden" name="status" value="<%= filters.status %>"><% } %>
            <% if (filters.metric) { %><input type="hidden" name="metric" value="<%= filters.metric %>"><% } %>
            <% if (leaderboard.pagination.limit !== 25) { %><input type="hidden" name="limit" value="<%= leaderboard.pagination.limit %>"><% } %>
            <label for="runner-search">Search runner or bib</label>
            <div class="leaderboard-search-control"><i data-lucide="search" aria-hidden="true"></i><input id="runner-search" name="search" type="search" value="<%= filters.search || '' %>" placeholder="Runner name or HR code"><button type="submit" class="leaderboard-button leaderboard-button-primary">Find result</button></div>
          </form>
        </div>

        <% if (presentation.showAdvancedFilters) { %><details class="leaderboard-filter-panel leaderboard-event-filter-panel" <%= presentation.hasActiveAdvancedFilters ? 'open' : '' %>>
          <summary><span><i data-lucide="sliders-horizontal" aria-hidden="true"></i> Result filters</span><% if (presentation.activeFilters.length) { %><span class="leaderboard-filter-count"><%= presentation.activeFilters.length %></span><% } %></summary>
          <form method="GET" action="/events/<%= event.slug %>/leaderboard" class="leaderboard-filter-form leaderboard-event-filter-form">
            <% if (!leaderboard.isEventWideMetricView) { %><input type="hidden" name="distance" value="<%= activeDistance.key || '' %>"><% } %>
            <% if (filters.search) { %><input type="hidden" name="search" value="<%= filters.search %>"><% } %>
            <% if (leaderboard.pagination.limit !== 25) { %><input type="hidden" name="limit" value="<%= leaderboard.pagination.limit %>"><% } %>
            <% if (presentation.showModeFilter) { %><div class="leaderboard-field"><label for="result-mode">Participation mode</label><select id="result-mode" name="mode"><option value="">All modes</option><option value="virtual" <%= filters.mode === 'virtual' ? 'selected' : '' %>>Virtual</option><option value="onsite" <%= filters.mode === 'onsite' ? 'selected' : '' %>>Onsite</option></select></div><% } %>
            <% if (presentation.showStatusFilter) { %><div class="leaderboard-field"><label for="result-status">Result status</label><select id="result-status" name="status"><option value="">Official and public pending</option><option value="verified" <%= filters.status === 'verified' ? 'selected' : '' %>>Verified only</option><option value="pending_review" <%= filters.status === 'pending_review' ? 'selected' : '' %>>Pending review only</option></select></div><% } %>
            <div class="leaderboard-filter-actions"><button type="submit" class="leaderboard-button leaderboard-button-primary">Apply filters</button><% if (presentation.hasActiveFilters) { %><a href="<%= presentation.clearFiltersUrl %>#official-standings" class="leaderboard-button leaderboard-button-secondary">Clear filters</a><% } %></div>
          </form>
        </details><% } %>

        <% if (presentation.activeFilters.length) { %><div class="leaderboard-filter-chips" aria-label="Active result filters"><% presentation.activeFilters.forEach((filter) => { %><a href="<%= filter.removeUrl %>#official-standings" class="leaderboard-filter-chip" aria-label="Remove <%= filter.label %> filter: <%= filter.value %>"><span><strong><%= filter.label %>:</strong> <%= filter.value %></span><i data-lucide="x" aria-hidden="true"></i></a><% }) %></div><% } %>
      </section>

      <section id="official-standings" class="leaderboard-official-section" aria-labelledby="official-standings-title">
        <% const hasDistanceMetric = (settings.trackedMetrics || []).includes('distance'); %>
        <% const hasStepsMetric = (settings.trackedMetrics || []).includes('steps'); %>
        <% const hasDualGoalMetrics = hasDistanceMetric && hasStepsMetric; %>
        <div class="leaderboard-section-heading"><div><p class="leaderboard-kicker">Counts toward rank</p><h2 id="official-standings-title">Official standings</h2><% if (Number(settings.publicRankCutoff || 0) > 0 && filters.status !== 'pending_review') { %><p>Public standings show rank #<%= settings.publicRankCutoff %> or better, including exact ties.</p><% } %></div><span><%= leaderboard.stats.verifiedEntries %> verified</span></div>
        <% if (leaderboard.officialEntries?.length) { %>
          <div class="leaderboard-mobile-results" aria-label="Official leaderboard result cards">
            <% leaderboard.officialEntries.forEach((entry) => { %>
              <article class="leaderboard-mobile-card leaderboard-rank-<%= entry.rank <= 3 ? entry.rank : 'standard' %> <%= isAccumulated ? 'leaderboard-progress-card' : '' %>">
                <div class="leaderboard-mobile-card-head"><div><p class="leaderboard-mobile-rank">#<%= entry.rank %><%= presentation.showCategoryColumn ? ` · ${entry.categoryLabel || entry.category}` : '' %></p><h3><%= entry.runnerName %></h3></div><span class="leaderboard-status-badge leaderboard-status-verified">Verified</span></div>
                <% if (isAccumulated) { %>
                  <div class="leaderboard-entry-progress">
                    <div><strong><%= entry.primaryMetricLabel %></strong><span><%= entry.isGoalComplete ? 'Goal completed' : entry.progressLabel %></span></div>
                    <div class="leaderboard-progress-track" role="progressbar" aria-label="<%= entry.runnerName %> verified challenge progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= entry.progressBarPercentage %>"><span style="--progress-width: <%= entry.progressBarPercentage %>%"></span></div>
                  </div>
                  <dl><% if (presentation.showDepartmentColumn) { %><div><dt>Department</dt><dd><%= entry.department || '—' %></dd></div><% } %><% if (hasDistanceMetric) { %><div><dt>Distance</dt><dd><%= entry.distanceLabel %></dd></div><% } %><% if (hasStepsMetric) { %><div><dt>Steps</dt><dd><%= entry.stepsLabel %></dd></div><% } %><% if (presentation.showElevationColumn) { %><div><dt>Elevation</dt><dd><%= entry.elevationLabel %></dd></div><% } %><div><dt>Activities</dt><dd><%= entry.activityCount %></dd></div><div><dt>Status</dt><dd><%= entry.isGoalComplete ? 'Finisher' : 'In progress' %></dd></div><div><dt>Updated</dt><dd><%= entry.latestVerificationLabel %></dd></div></dl>
                <% } else { %>
                  <dl><div><dt>Distance</dt><dd><%= entry.distanceLabel || 'N/A' %></dd></div><div><dt>Time</dt><dd><%= entry.timeLabel || '-' %></dd></div><div><dt>Pace</dt><dd><%= entry.paceLabel || '-' %></dd></div></dl>
                <% } %>
              </article>
            <% }) %>
          </div>
          <div class="leaderboard-table-wrap">
            <table class="leaderboard-table">
              <caption><%= activeDistance.label %> official verified rankings</caption>
              <% if (isAccumulated) { %>
                <thead><tr><th scope="col">Rank</th><th scope="col">Runner</th><% if (presentation.showDepartmentColumn) { %><th scope="col">Department</th><% } %><% if (presentation.showCategoryColumn) { %><th scope="col">Category</th><% } %><th scope="col"><%= primaryMetricLabel %></th><% if (presentation.showElevationColumn) { %><th scope="col">Elevation</th><% } %><% if (primaryMetric === 'elevation' && hasDistanceMetric) { %><th scope="col">Distance</th><% } %><% if (primaryMetric === 'elevation' && hasStepsMetric) { %><th scope="col">Steps</th><% } else if (hasDualGoalMetrics) { %><th scope="col">Secondary total</th><% } %><th scope="col">Goal progress</th><th scope="col">Activities</th><th scope="col">Latest verification</th></tr></thead>
                <tbody><% leaderboard.officialEntries.forEach((entry) => { %><tr class="leaderboard-rank-<%= entry.rank <= 3 ? entry.rank : 'standard' %>"><td><span class="leaderboard-rank-badge">#<%= entry.rank %></span></td><td class="leaderboard-runner-name"><%= entry.runnerName %><% if (entry.isPerfectAttendance) { %> <span class="leaderboard-status-badge leaderboard-status-verified" title="Active every day of the event">Perfect attendance</span><% } %></td><% if (presentation.showDepartmentColumn) { %><td><%= entry.department || '—' %></td><% } %><% if (presentation.showCategoryColumn) { %><td><%= entry.categoryLabel || entry.category || 'N/A' %></td><% } %><td><strong><%= entry.primaryMetricLabel %></strong></td><% if (presentation.showElevationColumn) { %><td><%= entry.elevationLabel %></td><% } %><% if (primaryMetric === 'elevation' && hasDistanceMetric) { %><td><%= entry.distanceLabel %></td><% } %><% if (primaryMetric === 'elevation' && hasStepsMetric) { %><td><%= entry.stepsLabel %></td><% } else if (hasDualGoalMetrics) { %><td><%= primaryMetric === 'steps' ? entry.distanceLabel : entry.stepsLabel %></td><% } %><td><div class="leaderboard-table-progress"><span><%= entry.isGoalComplete ? 'Finisher' : entry.progressLabel %></span><div class="leaderboard-progress-track" role="progressbar" aria-label="<%= entry.runnerName %> verified challenge progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= entry.progressBarPercentage %>"><span style="--progress-width: <%= entry.progressBarPercentage %>%"></span></div></div></td><td><%= entry.activityCountLabel %></td><td><%= entry.latestVerificationLabel %></td></tr><% }) %></tbody>
              <% } else { %>
                <thead><tr><% if (settings.visibleColumns.includes('rank')) { %><th scope="col">Rank</th><% } %><% if (settings.visibleColumns.includes('runner')) { %><th scope="col">Runner</th><% } %><% if (settings.visibleColumns.includes('category')) { %><th scope="col">Category</th><% } %><% if (settings.visibleColumns.includes('distance')) { %><th scope="col">Distance</th><% } %><% if (settings.visibleColumns.includes('steps')) { %><th scope="col">Steps</th><% } %><% if (settings.visibleColumns.includes('time')) { %><th scope="col">Time</th><% } %><% if (settings.visibleColumns.includes('pace')) { %><th scope="col">Pace</th><% } %><% if (settings.visibleColumns.includes('status')) { %><th scope="col">Status</th><% } %></tr></thead>
                <tbody><% leaderboard.officialEntries.forEach((entry) => { %><tr class="leaderboard-rank-<%= entry.rank <= 3 ? entry.rank : 'standard' %>"><% if (settings.visibleColumns.includes('rank')) { %><td><span class="leaderboard-rank-badge">#<%= entry.rank %></span></td><% } %><% if (settings.visibleColumns.includes('runner')) { %><td class="leaderboard-runner-name"><%= entry.runnerName %></td><% } %><% if (settings.visibleColumns.includes('category')) { %><td><%= entry.categoryLabel || entry.category || 'N/A' %></td><% } %><% if (settings.visibleColumns.includes('distance')) { %><td><%= entry.distanceLabel || 'N/A' %></td><% } %><% if (settings.visibleColumns.includes('steps')) { %><td><%= entry.stepsLabel || '-' %></td><% } %><% if (settings.visibleColumns.includes('time')) { %><td><strong><%= entry.timeLabel || '-' %></strong></td><% } %><% if (settings.visibleColumns.includes('pace')) { %><td><%= entry.paceLabel || '-' %></td><% } %><% if (settings.visibleColumns.includes('status')) { %><td><span class="leaderboard-status-badge leaderboard-status-verified"><span class="sr-only">Submission status: </span>Verified</span></td><% } %></tr><% }) %></tbody>
              <% } %>
            </table>
          </div>
        <% } else if (filters.status !== 'pending_review') { %>
          <div class="leaderboard-inline-empty"><h3><%= presentation.hasActiveFilters ? 'No verified runners match this search' : (isAccumulated ? 'No verified challenge progress yet' : 'No verified results yet') %></h3><p><%= presentation.hasActiveFilters ? 'Clear the search or filters to return to the full official field.' : (isAccumulated ? 'Runners will appear after their first accumulated activity is verified.' : 'Official rankings will begin after the organizer verifies submitted results.') %></p><a href="<%= presentation.hasActiveFilters ? presentation.clearFiltersUrl : `/events/${event.slug}` %>" class="leaderboard-button leaderboard-button-secondary"><%= presentation.hasActiveFilters ? 'Clear result filters' : 'Back to event' %></a></div>
        <% } %>

        <% if (presentation.pagination.totalPages > 1 && filters.status !== 'pending_review') { %><nav class="leaderboard-pagination" aria-label="Official standings pages"><a href="<%= presentation.pagination.getPageUrl(Math.max(1, presentation.pagination.page - 1)) %>" class="leaderboard-page-link <%= presentation.pagination.page === 1 ? 'is-disabled' : '' %>" <%= presentation.pagination.page === 1 ? 'aria-disabled="true" tabindex="-1"' : '' %>><i data-lucide="chevron-left" aria-hidden="true"></i> Previous</a><span>Page <strong><%= presentation.pagination.page %></strong> of <strong><%= presentation.pagination.totalPages %></strong></span><a href="<%= presentation.pagination.getPageUrl(Math.min(presentation.pagination.totalPages, presentation.pagination.page + 1)) %>" class="leaderboard-page-link <%= presentation.pagination.page === presentation.pagination.totalPages ? 'is-disabled' : '' %>" <%= presentation.pagination.page === presentation.pagination.totalPages ? 'aria-disabled="true" tabindex="-1"' : '' %>>Next <i data-lucide="chevron-right" aria-hidden="true"></i></a></nav><% } %>
      </section>

      <% if (settings.showPending && (leaderboard.pendingEntries?.length || filters.status === 'pending_review')) { %>
        <details class="leaderboard-pending-section" <%= filters.status === 'pending_review' ? 'open' : '' %>>
          <summary><span><strong>Pending review</strong><small>Public, but not officially ranked</small></span><span><%= leaderboard.stats.pendingEntries %> pending</span></summary>
          <% if (leaderboard.pendingEntries?.length) { %><div class="leaderboard-pending-list"><% leaderboard.pendingEntries.forEach((entry) => { %><article class="leaderboard-pending-card"><div><h3><%= entry.runnerName %></h3><p><%= isAccumulated ? `${entry.primaryMetricLabel} · ${entry.activityCountLabel} pending` : `${entry.categoryLabel || entry.category || activeDistance.label} · ${entry.participationMode || 'Event result'}` %></p></div><span class="leaderboard-status-badge leaderboard-status-pending_review">Pending review</span></article><% }) %></div><% } else { %><div class="leaderboard-inline-empty"><h3>No pending results match these filters</h3><p>Try returning to all public statuses.</p><a href="<%= presentation.clearFiltersUrl %>#official-standings" class="leaderboard-button leaderboard-button-secondary">Clear result filters</a></div><% } %>
        </details>
      <% } %>

      <aside class="leaderboard-status-legend" aria-label="Result status explanation"><p><span class="leaderboard-status-badge leaderboard-status-verified">Verified</span> Counts toward the official ranking<%= isAccumulated ? ' and challenge progress' : '' %>.</p><% if (settings.showPending) { %><p><span class="leaderboard-status-badge leaderboard-status-pending_review">Pending review</span> Visible only when allowed by the organizer and never assigned a rank.</p><% } %></aside>
    </div>
  </main>

  <%- include('../layouts/footer') %>
  <script src="/js/main.js"></script>
  <script>
    if (window.lucide) lucide.createIcons();
  </script>
</body>
</html>
