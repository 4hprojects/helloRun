<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../layouts/head', { title: title }) %>
  <link rel="stylesheet" href="/css/race-pass.css">
</head>
<body>
  <%- include('../layouts/nav') %>

  <main class="race-pass-page" id="main-content">
    <div class="race-pass-shell">
      <header class="race-pass-header">
        <p class="race-pass-kicker">Your registration</p>
        <h1><%= event && event.title ? event.title : 'Event' %></h1>
        <% if (event && event.venueName) { %><p class="race-pass-venue"><%= event.venueName %></p><% } %>
      </header>

      <section class="race-pass-card">
        <% if (registration.status !== 'cancelled' && locals.onsite && locals.onsite.bibNumber) { %>
          <p class="race-pass-bib-label">Your bib</p>
          <p class="race-pass-bib"><%= onsite.bibNumber %></p>
          <% if (locals.qrDataUrl) { %>
            <img class="race-pass-qr" src="<%= qrDataUrl %>" alt="Check-in QR code for bib <%= onsite.bibNumber %>" width="260" height="260">
            <p class="race-pass-hint">Show this at the check-in desk. It is scanned once and re-drawn every time you open this page, so a screenshot still works.</p>
          <% } %>
          <% if (onsite.checkedInAt) { %>
            <p class="race-pass-status">Checked in.</p>
          <% } %>
          <p class="race-pass-bib-label">Confirmation code</p>
          <p class="race-pass-code"><%= registration.confirmationCode %></p>
        <% } else { %>
          <p class="race-pass-bib-label">Confirmation code</p>
          <p class="race-pass-bib"><%= registration.confirmationCode %></p>
          <% if (registration.status === 'cancelled') { %>
            <p class="race-pass-status">This registration was cancelled.</p>
          <% } else if (registration.participationMode === 'onsite') { %>
            <p class="race-pass-hint">Your bib appears here once the organiser has assigned one.</p>
          <% } %>
        <% } %>
      </section>

      <section class="race-pass-details">
        <h2>Details</h2>
        <dl>
          <div><dt>Name</dt><dd><%= [registration.participant.firstName, registration.participant.lastName].filter(Boolean).join(' ') %></dd></div>
          <div><dt>Email</dt><dd><%= registration.participant.email %></dd></div>
          <% if (registration.raceDistance) { %><div><dt>Category</dt><dd><%= registration.raceDistance %></dd></div><% } %>
          <div><dt>Participation</dt><dd><%= registration.participationMode %></dd></div>
          <% if (registration.paymentStatus && registration.paymentStatus !== 'paid') { %>
            <div><dt>Payment</dt><dd><%= registration.paymentStatus %></dd></div>
          <% } %>
        </dl>
      </section>

      <section class="guest-link-card">
        <h2>Claim this registration</h2>
        <p>
          A result recorded for you at the event still counts and appears on the
          leaderboard. Your badges and certificate need an account, though, and so does
          submitting your own run proof. Create an account with
          <strong><%= registration.participant.email %></strong>, or sign in if you already
          have one, and this registration moves across — along with anything that was
          waiting for it.
        </p>
        <p><a class="nav-signup-btn" href="/signup">Create an account</a> <a class="nav-login-btn" href="/login">Sign in</a></p>
        <p class="race-pass-hint">Already signed in? <a href="/my-registrations/claim">Claim it now</a>.</p>
      </section>
    </div>
  </main>

  <%- include('../layouts/footer') %>
  <script src="/js/main.js"></script>
</body>
</html>
