<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../layouts/head', { title: title }) %>
  <link rel="stylesheet" href="/css/race-pass.css">
</head>
<body>
  <%- include('../layouts/nav') %>

  <main class="race-pass-page" id="main-content">
    <div class="race-pass-shell">
      <header class="race-pass-header">
        <p class="race-pass-kicker">Register as a guest</p>
        <h1><%= event.title %></h1>
        <% if (event.venueName) { %><p class="race-pass-venue"><%= event.venueName %></p><% } %>
      </header>

      <p class="race-pass-hint">
        You can register without a HelloRun account. You will get a private link to your
        registration by email. To submit results, earn badges or download a certificate,
        you will need an account — you can create one later and keep this registration.
      </p>

      <% if (errors.form) { %><p class="checkin-alert" role="alert"><%= errors.form %></p><% } %>

      <form method="POST" action="/events/<%= event.slug %>/register/guest" class="guest-form">
        <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">

        <label for="firstName">First name
          <input id="firstName" name="firstName" value="<%= form.firstName || '' %>" required maxlength="80">
        </label>
        <% if (errors.firstName) { %><p class="guest-error"><%= errors.firstName %></p><% } %>

        <label for="lastName">Last name
          <input id="lastName" name="lastName" value="<%= form.lastName || '' %>" required maxlength="80">
        </label>
        <% if (errors.lastName) { %><p class="guest-error"><%= errors.lastName %></p><% } %>

        <label for="email">Email
          <input id="email" name="email" type="email" value="<%= form.email || '' %>" required maxlength="200">
        </label>
        <p class="race-pass-hint">Your confirmation and your private link are sent here.</p>
        <% if (errors.email) { %><p class="guest-error"><%= errors.email %></p><% } %>

        <label for="mobile">Contact number
          <input id="mobile" name="mobile" value="<%= form.mobile || '' %>" required maxlength="40">
        </label>
        <% if (errors.mobile) { %><p class="guest-error"><%= errors.mobile %></p><% } %>

        <label for="participationMode">Participation
          <select id="participationMode" name="participationMode">
            <option value="onsite" <%= form.participationMode === 'onsite' ? 'selected' : '' %>>Onsite</option>
            <option value="virtual" <%= form.participationMode === 'virtual' ? 'selected' : '' %>>Virtual</option>
          </select>
        </label>

        <% if ((event.raceDistances || []).length) { %>
          <label for="raceDistance">Category
            <select id="raceDistance" name="raceDistance">
              <% event.raceDistances.forEach(function (distance) { %>
                <option value="<%= distance %>" <%= form.raceDistance === distance ? 'selected' : '' %>><%= distance %></option>
              <% }); %>
            </select>
          </label>
        <% } %>


        <% if ((event.kitInventory || []).length) { %>
          <label for="kitSize">Race kit size<% if (event.kitSizeRequired) { %> *<% } %>
            <select id="kitSize" name="kitSize" <%= event.kitSizeRequired ? 'required' : '' %>>
              <option value=""><%= event.kitSizeRequired ? 'Select a size' : 'No preference' %></option>
              <% (event.kitInventory || []).forEach(function (entry) {
                   var left = Math.max(0, (Number(entry.stock) || 0) - (Number(entry.released) || 0)); %>
                <option value="<%= entry.size %>" <%= form.kitSize === entry.size ? 'selected' : '' %> <%= left > 0 ? '' : 'disabled' %>><%= entry.size %><%= left > 0 ? '' : ' — none left' %></option>
              <% }); %>
            </select>
          </label>
          <% if (errors.kitSize) { %><p class="guest-error"><%= errors.kitSize %></p><% } %>
        <% } %>
        <label for="emergencyContactName">Emergency contact name
          <input id="emergencyContactName" name="emergencyContactName" value="<%= form.emergencyContactName || '' %>" maxlength="120">
        </label>
        <% if (errors.emergencyContactName) { %><p class="guest-error"><%= errors.emergencyContactName %></p><% } %>

        <label for="emergencyContactNumber">Emergency contact number
          <input id="emergencyContactNumber" name="emergencyContactNumber" value="<%= form.emergencyContactNumber || '' %>" maxlength="40">
        </label>
        <% if (errors.emergencyContactNumber) { %><p class="guest-error"><%= errors.emergencyContactNumber %></p><% } %>

        <fieldset class="guest-waiver">
          <legend>Waiver</legend>
          <div class="guest-waiver-body"><%= event.waiverTemplate || 'By registering you accept the event waiver.' %></div>
          <label class="guest-check">
            <input type="checkbox" name="waiverAccepted" <%= form.waiverAccepted ? 'checked' : '' %>>
            <span>I accept the event waiver.</span>
          </label>
          <% if (errors.waiverAccepted) { %><p class="guest-error"><%= errors.waiverAccepted %></p><% } %>
          <label for="waiverSignature">Type your full name to sign
            <input id="waiverSignature" name="waiverSignature" value="<%= form.waiverSignature || '' %>" maxlength="120">
          </label>
          <% if (errors.waiverSignature) { %><p class="guest-error"><%= errors.waiverSignature %></p><% } %>
        </fieldset>

        <% if (turnstileSiteKey) { %>
          <div class="cf-turnstile" data-sitekey="<%= turnstileSiteKey %>"></div>
          <% if (errors.turnstile) { %><p class="guest-error"><%= errors.turnstile %></p><% } %>
        <% } %>

        <button type="submit" class="nav-signup-btn">Register</button>
      </form>

      <p class="race-pass-back"><a href="/events/<%= event.slug %>">Back to event</a></p>
    </div>
  </main>

  <%- include('../layouts/footer') %>
  <script src="/js/main.js"></script>
  <% if (turnstileSiteKey) { %><script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script><% } %>
</body>
</html>
