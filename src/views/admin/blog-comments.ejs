<!DOCTYPE html><html lang="en"><head><%- include('../layouts/head', { title }) %><link rel="stylesheet" href="/css/admin.css"><link rel="stylesheet" href="/css/admin-blog.css"></head><body><%- include('../layouts/nav') %>
<main class="blog-admin-page"><header class="blog-admin-header"><div><h1>Blog Management</h1><p>Review and moderate community comments.</p></div><a class="btn btn-secondary" href="/admin/dashboard">Admin Dashboard</a></header>
<%- include('partials/blog-management-nav', { active: 'comments' }) %>
<form class="blog-admin-filters" method="GET" action="/admin/blog/comments"><label>Search comments<input type="search" name="q" value="<%= searchQuery %>" placeholder="Comment text"></label><label>Status<select name="status"><option value="active" <%= selectedStatus === 'active' ? 'selected' : '' %>>Active</option><option value="removed" <%= selectedStatus === 'removed' ? 'selected' : '' %>>Removed</option></select></label><button class="btn" type="submit">Apply</button></form>
<div class="blog-admin-list"><% comments.forEach((comment) => { %><article class="blog-admin-comment"><div class="blog-admin-header"><div><strong><%= [comment.authorId?.firstName, comment.authorId?.lastName].filter(Boolean).join(' ') || comment.authorId?.email || 'Unknown author' %></strong><p class="blog-admin-meta"><% if(comment.blogId?.slug){ %><a href="/blog/<%= comment.blogId.slug %>#comment-<%= comment._id %>" target="_blank" rel="noopener noreferrer"><%= comment.blogId.title %></a><% } else { %>Unavailable post<% } %> · <%= new Date(comment.createdAt).toLocaleString() %></p></div><span class="blog-admin-badge <%= comment.status %>"><%= comment.status %></span></div><blockquote><%= comment.content %></blockquote><% if(comment.moderationNote){ %><p class="blog-admin-meta"><strong>Moderation note:</strong> <%= comment.moderationNote %></p><% } %><form data-comment-action method="POST" action="/admin/blog/comments/<%= comment._id %>/<%= selectedStatus === 'removed' ? 'restore' : 'remove' %>"><input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>"><% if(selectedStatus !== 'removed'){ %><input type="text" name="moderationNote" required minlength="5" maxlength="500" placeholder="Reason for removal"><% } %><button class="btn <%= selectedStatus === 'removed' ? 'btn-secondary' : 'btn-danger' %>" type="submit"><%= selectedStatus === 'removed' ? 'Restore' : 'Remove' %></button></form></article><% }) %></div>
<% if(!comments.length){ %><div class="blog-admin-empty">No comments match these filters.</div><% } %><% if(pagination.totalPages>1){const params=new URLSearchParams({status:selectedStatus,q:searchQuery});%><nav class="blog-admin-pagination"><% if(pagination.page>1){params.set('page',pagination.page-1);%><a class="btn btn-secondary" href="?<%= params %>">Previous</a><% } %><span>Page <%= pagination.page %> of <%= pagination.totalPages %></span><% if(pagination.page<pagination.totalPages){params.set('page',pagination.page+1);%><a class="btn btn-secondary" href="?<%= params %>">Next</a><% } %></nav><% } %></main>
<%- include('../layouts/footer') %><script src="/js/main.js"></script><script src="/js/admin-blog-comments.js"></script></body></html>
