<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../../layouts/head', { title }) %>
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="stylesheet" href="/css/admin-ocr.css">
</head>
<body>
  <%- include('../../layouts/nav') %>
  <main class="admin-page ocr-admin-page ocr-audit-page" id="main-content">
    <section class="section admin-shell">
      <%- include('_header') %>
      <section class="ocr-panel" aria-labelledby="ocr-audit-heading">
        <div class="ocr-section-heading"><div><h2 id="ocr-audit-heading">Recent administrative actions</h2><p>Append-only record. The 100 most recent actions are shown.</p></div><span class="ocr-pill"><%= rows.length %> shown</span></div>
        <% if (!rows.length) { %>
          <p class="ocr-empty">No OCR administration actions recorded yet.</p>
        <% } else { %>
          <div class="admin-users-table-wrap">
            <table class="admin-table ocr-table ocr-responsive-table">
              <thead><tr><th>When</th><th>Action</th><th>Actor</th><th>Target</th><th>Status</th><th>Reason</th></tr></thead>
              <tbody>
                <% rows.forEach((row) => { %>
                  <tr>
                    <td data-label="When"><%= formatDateTime(row.createdAt) %></td>
                    <td data-label="Action"><%= row.action %></td>
                    <td data-label="Actor"><%= row.actorId ? String(row.actorId) : 'system' %></td>
                    <td data-label="Target"><%= row.targetType %> <%= row.targetId %></td>
                    <td data-label="Status"><%= row.statusFrom || '—' %> → <%= row.statusTo || '—' %></td>
                    <td data-label="Reason"><%= row.reason || '—' %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </section>
    </section>
  </main>
  <%- include('../../layouts/footer') %>
  <script nonce="<%= locals.cspNonce || String() %>" src="/js/admin-ocr.js"></script>
  <script nonce="<%= locals.cspNonce || String() %>" src="/js/main.js"></script>
</body>
</html>
