<div class="admin-header-row">
  <div>
    <h1>OCR Training Center</h1>
    <p>Platform-aware OCR, reviewed ground truth, manual training and model control.</p>
  </div>
  <div class="admin-user-header-actions">
    <a href="/admin/dashboard" class="btn btn-secondary">Admin Dashboard</a>
  </div>
</div>
<% const ocrTabs = [
  ['overview', '/admin/ocr-training', 'Overview'],
  ['samples', '/admin/ocr-training/samples', 'Samples'],
  ['platforms', '/admin/ocr-training/platforms', 'Platforms'],
  ['jobs', '/admin/ocr-training/jobs', 'Jobs'],
  ['models', '/admin/ocr-training/models', 'Models'],
  ['analytics', '/admin/ocr-training/analytics', 'Analytics'],
  ['settings', '/admin/ocr-training/settings', 'Settings'],
  ['audit', '/admin/ocr-training/audit', 'Audit']
]; %>
<nav aria-label="OCR Training Center sections">
  <ul class="ocr-tabs">
    <% ocrTabs.forEach(([key, href, label]) => { %>
      <li><a href="<%= href %>" <%= section === key ? 'aria-current=page' : '' %>><%= label %></a></li>
    <% }) %>
  </ul>
</nav>
<ul class="ocr-flags" aria-label="Feature flags">
  <% (flags || []).forEach((flag) => { %>
    <li><span class="ocr-pill <%= flag.enabled ? 'ocr-pill-on' : '' %>"><%= flag.name %>: <%= flag.enabled ? 'on' : 'off' %></span></li>
  <% }) %>
</ul>
<% if (message) { %>
  <div class="admin-alert admin-alert-<%= message.type %>" role="status"><%= message.text %></div>
<% } %>
