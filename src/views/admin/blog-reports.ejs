<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../layouts/head', { title: title || 'Blog Reports - HelloRun Admin' }) %>
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="stylesheet" href="/css/admin-blog.css">
</head>
<body>
  <%- include('../layouts/nav') %>
  <main class="blog-admin-page">
    <header style="display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap;">
      <div>
        <h1 style="margin:0;">Blog Management</h1>
        <p style="margin:.35rem 0 0;color:#64748b;">Moderate reported blog posts and comments.</p>
      </div>
      <a class="btn btn-secondary" href="/admin/dashboard">Admin Dashboard</a>
    </header>
    <%- include('partials/blog-management-nav', { active: 'reports' }) %>
      <form method="GET" action="/admin/blog/reports" class="blog-admin-filters">
        <label>Status
        <select name="status">
          <option value="open" <%= selectedStatus === 'open' ? 'selected' : '' %>>Open</option>
          <option value="resolved" <%= selectedStatus === 'resolved' ? 'selected' : '' %>>Resolved</option>
          <option value="dismissed" <%= selectedStatus === 'dismissed' ? 'selected' : '' %>>Dismissed</option>
        </select>
        </label>
        <label>Target<select name="targetType"><option value="">All targets</option><option value="post" <%= selectedTargetType === 'post' ? 'selected' : '' %>>Posts</option><option value="comment" <%= selectedTargetType === 'comment' ? 'selected' : '' %>>Comments</option></select></label>
        <label>Reason<select name="reason"><option value="">All reasons</option><% reasons.forEach((reason) => { %><option value="<%= reason %>" <%= selectedReason === reason ? 'selected' : '' %>><%= reason %></option><% }) %></select></label>
        <label>Reported from<input type="date" name="dateFrom" value="<%= dateFrom %>"></label>
        <label>Reported through<input type="date" name="dateTo" value="<%= dateTo %>"></label>
        <button class="btn" type="submit">Apply</button>
      </form>

    <% if (reports && reports.length) { %>
      <div style="display:grid;gap:.85rem;">
        <% reports.forEach((report) => { %>
          <article style="border:1px solid #e2e8f0;border-radius:12px;padding:1rem;background:#fff;">
            <div style="display:flex;justify-content:space-between;gap:.75rem;flex-wrap:wrap;">
              <div>
                <strong><%= report.targetType === 'post' ? 'Post report' : 'Comment report' %></strong>
                <p style="margin:.35rem 0 0;color:#64748b;">
                  Reason: <strong><%= report.reason %></strong>
                  <% if (report.blogId?.slug) { %>| <a href="/blog/<%= report.blogId.slug %><%= report.commentId?._id ? `?focus=${report.commentId._id}#comment-${report.commentId._id}` : '' %>" target="_blank" rel="noopener noreferrer">View content</a><% } %>
                </p>
              </div>
              <span style="text-transform:uppercase;font-size:.8rem;font-weight:700;color:#334155;"><%= report.status %></span>
            </div>
            <p style="margin:.65rem 0 0;"><strong>Reporter:</strong> <%= report.reporterId?.firstName || '' %> <%= report.reporterId?.lastName || '' %> (<%= report.reporterId?.email || 'unknown' %>)</p>
            <% if (report.blogId?.title) { %><p style="margin:.45rem 0 0;"><strong>Post:</strong> <%= report.blogId.title %></p><% } %>
            <% if (report.targetType === 'comment') { %>
              <% const reportedCommentText = report.commentContentSnapshot || report.commentId?.content || ''; %>
              <% const currentCommentText = report.commentId?.content || ''; %>
              <% if (reportedCommentText) { %>
                <p style="margin:.45rem 0 0;"><strong>Reported version:</strong> <%= reportedCommentText %></p>
              <% } %>
              <% if (report.commentRevisionAtSnapshot) { %>
                <p style="margin:.3rem 0 0;color:#64748b;font-size:.9rem;">Captured <%= new Date(report.commentRevisionAtSnapshot).toLocaleString('en-US') %> after <%= Number(report.commentEditCountSnapshot || 0) %> edit(s).</p>
              <% } %>
              <% if (currentCommentText && reportedCommentText && currentCommentText !== reportedCommentText) { %>
                <p style="margin:.45rem 0 0;"><strong>Current version:</strong> <%= currentCommentText %></p>
                <p style="margin:.3rem 0 0;color:#9a3412;font-size:.9rem;">The comment changed after the reported version was captured.</p>
              <% } %>
            <% } %>
            <% if (report.note) { %><p style="margin:.45rem 0 0;"><strong>Note:</strong> <%= report.note %></p><% } %>
            <% if (selectedStatus === 'open') { %>
              <div style="display:flex;gap:.65rem;flex-wrap:wrap;margin-top:.85rem;">
                <form method="POST" action="/admin/blog/reports/<%= report._id %>/resolve" style="display:flex;gap:.5rem;align-items:center;flex-wrap:wrap;">
                  <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
                  <select name="outcome" required><option value="">Choose outcome</option><option value="remove_target">Remove/archive target</option><option value="retain_target">Retain target</option><option value="escalate">Escalate</option></select>
                  <input type="text" name="resolutionNote" placeholder="Resolution note (required)" required minlength="10" maxlength="500">
                  <button class="btn" type="submit">Close report</button>
                </form>
              </div>
            <% } else if (report.resolutionNote) { %>
              <p style="margin:.7rem 0 0;color:#475569;"><strong>Resolution:</strong> <%= report.resolutionNote %></p>
            <% } %>
          </article>
        <% }) %>
      </div>
    <% } else { %>
      <div style="border:1px dashed #cbd5e1;border-radius:12px;padding:1.2rem;color:#64748b;">No reports found.</div>
    <% } %>
    <% if (pagination.totalPages > 1) { const params = new URLSearchParams({status:selectedStatus,targetType:selectedTargetType,reason:selectedReason,dateFrom,dateTo}); %><nav class="blog-admin-pagination"><% if (pagination.page > 1) { params.set('page', pagination.page - 1); %><a class="btn btn-secondary" href="?<%= params %>">Previous</a><% } %><span>Page <%= pagination.page %> of <%= pagination.totalPages %></span><% if (pagination.page < pagination.totalPages) { params.set('page', pagination.page + 1); %><a class="btn btn-secondary" href="?<%= params %>">Next</a><% } %></nav><% } %>
  </main>
  <%- include('../layouts/footer') %>
  <script src="/js/main.js"></script>
</body>
</html>
