<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../layouts/head', { title: title || 'Review Blog - HelloRun Admin' }) %>
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="stylesheet" href="/css/admin-blog.css">
  <link rel="stylesheet" href="/css/admin-blog-review.css">
</head>
<body>
  <%- include('../layouts/nav') %>
  <main style="padding: 2rem; max-width: 980px; margin: 0 auto;">
    <header style="display: flex; justify-content: space-between; align-items: center; gap: 0.8rem; flex-wrap: wrap; margin-bottom: 1rem;">
      <div>
        <h1 style="margin-bottom: 0.25rem;">Review Blog Post</h1>
        <p style="margin: 0; color: #64748b;">Moderation page for publishing decisions.</p>
      </div>
      <a href="/admin/blog/review" class="mod-back-btn">Back to Queue</a>
    </header>
    <%- include('partials/blog-management-nav', { active: 'posts' }) %>
    <div class="blog-admin-tabs" role="tablist" aria-label="Review mode"><button type="button" class="btn is-active" id="adminEditTab" role="tab" aria-selected="true">Edit &amp; moderate</button><button type="button" class="btn btn-secondary" id="adminPreviewTab" role="tab" aria-selected="false">Rendered preview</button></div>

    <% if (message) { %>
      <div style="margin-bottom: 0.8rem; padding: 0.7rem; border-radius: 8px; font-weight: 600; border: 1px solid <%= message.type === 'error' ? '#fecaca' : '#86efac' %>; background: <%= message.type === 'error' ? '#fee2e2' : '#dcfce7' %>; color: <%= message.type === 'error' ? '#991b1b' : '#166534' %>;">
        <%= message.text %>
      </div>
    <% } %>

    <article id="adminEditorPanel" role="tabpanel" style="border: 1px solid #e2e8f0; border-radius: 12px; background: #fff; overflow: hidden;">
      <img id="adminArticleCover" src="<%= post.coverImageUrl || '' %>" alt="<%= post.title %> cover" style="width: 100%; max-height: 320px; object-fit: cover;<%= post.coverImageUrl ? '' : ' display:none;' %>">
      <div style="padding: 1rem 1.1rem;">
        <p style="margin: 0.2rem 0 0; color: #64748b;">
          Author: <%= post.authorId?.firstName || '' %> <%= post.authorId?.lastName || '' %> (<%= post.authorId?.email || 'N/A' %>)
        </p>
        <p id="adminPostMeta" style="margin: 0.2rem 0 0; color: #64748b;">
          <%= post.category === 'Other' && post.customCategory ? post.customCategory : post.category %> | <span id="adminPostReadingTime"><%= post.readingTime || 1 %></span> min read | Status: <strong id="adminPostStatus"><%= post.status %></strong> | Slug: <span id="adminPostSlug">/blog/<%= post.slug %></span>
        </p>
        <% if (reviewTarget?.kind === 'revision') { %>
          <p style="margin-top:.55rem;color:#9a3412;"><strong>Revision review:</strong> The public post stays live until this revision is approved.</p>
        <% } %>

        <% if (post.rejectionReason) { %>
          <p style="margin-top: 0.6rem; color: #991b1b;"><strong>Previous rejection reason:</strong> <%= post.rejectionReason %></p>
        <% } %>

        <form id="adminAutosaveForm" class="admin-edit-grid">
          <div class="admin-edit-head">
            <h3 class="admin-edit-title">Admin Edit (Auto-save)</h3>
            <span id="autosaveStatus" class="autosave-status" data-state="idle">No changes</span>
          </div>
          <p id="adminChangedFields" class="admin-changed-fields">Changed fields: none</p>
          <div class="admin-edit-fields">
            <div class="admin-field admin-field-wide"><h4>Content</h4></div>
            <div class="admin-field admin-field-wide">
              <label for="adminTitle">Title</label>
              <input id="adminTitle" name="title" type="text" value="<%= post.title %>" maxlength="120" required>
            </div>
            <div class="admin-field admin-field-wide">
              <label for="adminExcerpt">Excerpt</label>
              <textarea id="adminExcerpt" name="excerpt" maxlength="220"><%= post.excerpt || '' %></textarea>
            </div>
            <div class="admin-field">
              <label for="adminCategory">Category</label>
              <select id="adminCategory" name="category" required>
                <% (categories || []).forEach((category) => { %>
                  <option value="<%= category %>" <%= post.category === category ? 'selected' : '' %>><%= category %></option>
                <% }) %>
              </select>
            </div>
            <div class="admin-field" id="adminCustomCategoryWrap" <%= post.category === 'Other' ? '' : 'style="display:none;"' %>>
              <label for="adminCustomCategory">Custom Category</label>
              <input id="adminCustomCategory" name="customCategory" type="text" value="<%= post.customCategory || '' %>" maxlength="80">
            </div>
            <div class="admin-field">
              <label>Workflow status</label>
              <input id="adminStatus" type="hidden" value="<%= post.status %>">
              <span class="status-badge <%= post.status === 'pending' ? 'status-pending' : (post.status === 'published' ? 'status-published' : 'status-other') %>"><%= post.status %></span>
              <small class="admin-field-help">Status changes use the explicit moderation actions below.</small>
            </div>
            <div class="admin-field">
              <label for="adminTags">Tags (comma separated)</label>
              <input id="adminTags" name="tags" type="text" value="<%= Array.isArray(post.tags) ? post.tags.join(', ') : '' %>">
            </div>
            <div class="admin-field admin-field-wide"><h4>Media</h4></div>
            <div class="admin-field admin-field-wide">
              <label for="adminCoverImageUrl">Cover Image URL</label>
              <input id="adminCoverImageUrl" name="coverImageUrl" type="text" inputmode="url" autocomplete="url" value="<%= post.coverImageUrl || '' %>">
              <div class="admin-image-manager">
                <img id="adminCoverPreview" class="admin-image-preview" src="<%= post.coverImageUrl || '' %>" alt="Cover preview" <%= post.coverImageUrl ? '' : 'hidden' %>>
                <div class="admin-image-actions">
                  <label class="admin-image-upload-label">Upload or replace
                    <input id="adminCoverImageFile" type="file" accept="image/jpeg,image/png,image/webp">
                  </label>
                  <button id="adminRemoveCover" type="button">Remove cover</button>
                </div>
                <p id="adminCoverUploadState" class="admin-upload-state" data-state="saved">JPEG/PNG uploads are converted to WebP.</p>
              </div>
            </div>
            <div class="admin-field admin-field-wide">
              <label for="adminCoverImageAlt">Cover Image Alt Text</label>
              <input id="adminCoverImageAlt" name="coverImageAlt" type="text" value="<%= post.coverImageAlt || '' %>" maxlength="180">
            </div>
            <div class="admin-field admin-field-wide">
              <label for="adminGalleryImageUrls">Gallery Image URLs</label>
              <textarea id="adminGalleryImageUrls" name="galleryImageUrls" placeholder="One URL per line"><%= Array.isArray(post.galleryImageUrls) ? post.galleryImageUrls.join('\n') : '' %></textarea>
              <div class="admin-image-manager">
                <div id="adminGalleryPreview" class="admin-gallery-grid"></div>
                <div class="admin-image-actions">
                  <label class="admin-image-upload-label">Add images
                    <input id="adminGalleryImageFiles" type="file" accept="image/jpeg,image/png,image/webp" multiple>
                  </label>
                  <span id="adminGallerySlots" class="admin-field-help"></span>
                </div>
                <p id="adminGalleryUploadState" class="admin-upload-state" data-state="saved">Maximum 3 images. JPEG/PNG uploads are converted to WebP.</p>
              </div>
            </div>
            <% const adminHasStructuredBlocks = post.contentBlocks && post.contentBlocks.length; %>
            <% if (adminHasStructuredBlocks) { %>
              <div class="admin-field">
                <label for="adminTemplateKey">Template</label>
                <select id="adminTemplateKey" name="templateKey">
                  <% (templates || []).forEach((template) => { %>
                    <option value="<%= template.key %>" <%= post.templateKey === template.key ? 'selected' : '' %>><%= template.label %></option>
                  <% }) %>
                </select>
              </div>
              <div class="admin-field admin-field-wide">
                <label>Structured Content Blocks</label>
                <input type="hidden" id="adminContentBlocksJson" name="contentBlocksJson" value="">
                <div class="admin-composer" id="adminStructuredComposer">
                  <div class="admin-composer-toolbar">
                    <select id="adminAddBlockType" aria-label="Block type to add">
                      <% (blockTypes || []).forEach((blockType) => { %>
                        <option value="<%= blockType.key %>" <%= blockType.key === 'textSection' ? 'selected' : '' %>><%= blockType.label %></option>
                      <% }) %>
                    </select>
                    <button type="button" id="adminAddBlockBtn">Add Block</button>
                  </div>
                  <div id="adminComposerBlockList" style="display:grid;gap:0.5rem;"></div>
                  <div class="admin-composer-preview" id="adminComposerPreview"></div>
                </div>
                <p class="admin-field-help">Structured posts save blocks as the source content and regenerate sanitized HTML.</p>
              </div>
            <% } %>
            <div class="admin-field admin-field-wide">
              <label for="adminContentHtml"><%= adminHasStructuredBlocks ? 'Generated Content HTML' : 'Content HTML' %></label>
              <textarea id="adminContentHtml" name="contentHtml" style="min-height: 220px;" <%= adminHasStructuredBlocks ? 'readonly' : '' %>><%- post.contentHtml || '' %></textarea>
            </div>
            <div class="admin-field admin-field-wide">
              <label for="adminContentRaw">Content Raw / Notes</label>
              <textarea id="adminContentRaw" name="contentRaw"><%= post.contentRaw || '' %></textarea>
            </div>
            <div class="admin-field admin-field-wide"><h4>SEO</h4></div>
            <div class="admin-field">
              <label for="adminSeoTitle">SEO Title</label>
              <input id="adminSeoTitle" name="seoTitle" type="text" value="<%= post.seoTitle || '' %>" maxlength="160">
            </div>
            <div class="admin-field">
              <label for="adminOgImageUrl">OG Image URL</label>
              <input id="adminOgImageUrl" name="ogImageUrl" type="text" inputmode="url" autocomplete="url" value="<%= post.ogImageUrl || '' %>" maxlength="2000">
            </div>
            <div class="admin-field admin-field-wide">
              <label for="adminSeoDescription">SEO Description</label>
              <textarea id="adminSeoDescription" name="seoDescription" maxlength="320"><%= post.seoDescription || '' %></textarea>
            </div>
            <div class="admin-field admin-field-wide"><h4>Moderation</h4></div>
            <div class="admin-field admin-field-wide">
              <label for="adminModerationNotes">Moderation Notes</label>
              <textarea id="adminModerationNotes" name="moderationNotes" maxlength="1000"><%= post.moderationNotes || '' %></textarea>
            </div>
            <div class="admin-field admin-field-wide">
              <label>Moderation Flags</label>
              <p id="adminModerationFlags" class="admin-field-help"><%= (post.moderationFlags && post.moderationFlags.length) ? post.moderationFlags.join(', ') : 'No active moderation flags.' %></p>
              <p class="admin-field-help">Open post reports: <strong><%= openReportCounts?.post || 0 %></strong> | Open comment reports: <strong><%= openReportCounts?.comment || 0 %></strong></p>
            </div>
            <div class="admin-field admin-field-wide"><p class="admin-field-help">Content changes are saved automatically after you stop typing. Workflow and featured status use the explicit actions below.</p></div>
          </div>
        </form>

      </div>
    </article>
    <article id="adminPreviewPanel" role="tabpanel" hidden style="border:1px solid #e2e8f0;border-radius:12px;background:#fff;padding:clamp(1rem,4vw,3rem);">
      <header><p id="adminPreviewCategory" class="blog-admin-badge"><%= post.category %></p><h1 id="adminPreviewTitle"><%= post.title %></h1><p id="adminPreviewExcerpt"><%= post.excerpt || '' %></p></header>
      <img id="adminPreviewCover" src="<%= post.coverImageUrl || '' %>" alt="<%= post.coverImageAlt || '' %>" style="width:100%;max-height:420px;object-fit:cover;border-radius:12px;margin:1rem 0;<%= post.coverImageUrl ? '' : 'display:none;' %>">
      <div id="adminRenderedContent" class="blog-article-content"><%- post.contentHtml || '' %></div>
    </article>

    <section class="moderation-panel" aria-labelledby="moderation-title">
      <div class="moderation-panel-head">
        <h3 id="moderation-title">Moderation Decision</h3>
        <% const statusClass = post.status === 'pending' ? 'status-pending' : (post.status === 'published' ? 'status-published' : 'status-other'); %>
        <span id="moderationStatusBadge" class="status-badge <%= statusClass %>"><%= post.status %></span>
      </div>
      <p class="moderation-panel-note">Choose what to do with this post after review.</p>
      <div class="moderation-actions">
        <% if (['pending', 'published', 'scheduled'].includes(post.status)) { %>
          <section class="mod-card js-pending-actions">
            <h4>Primary Decision</h4>
            <p>Approve the reviewed content for immediate or scheduled publication.</p>
            <form method="POST" action="/admin/blog/posts/<%= post._id %>/approve-form" class="moderation-approve-form">
              <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
              <div class="moderation-review-summary" aria-label="Content eligibility summary">
                <p><strong><%= publicationEligibility.wordCount %></strong> words · <strong><%= publicationEligibility.semanticUnitCount %></strong> semantic units · <strong><%= publicationEligibility.externalLinkCount %></strong> external links</p>
                <% if (!publicationEligibility.eligible) { %>
                  <p class="moderation-hint-invalid">Publication blocked: <%= publicationEligibility.blockingReasons.join(', ') %></p>
                <% } %>
              </div>
              <label class="admin-inline">
                <input type="checkbox" name="originalityConfirmed" value="true" required>
                I confirmed this post is original or the author has the necessary publishing rights.
              </label>
              <% if (publicationEligibility.externalLinkCount > 0) { %>
                <label class="admin-inline">
                  <input type="checkbox" name="externalLinksConfirmed" value="true" required>
                  I reviewed every external link for relevance and safety.
                </label>
              <% } %>
                <fieldset class="moderation-health-checks">
                  <legend>Health-content review (required when classified health or safety)</legend>
                  <label class="admin-inline"><input type="checkbox" name="healthExperienceConfirmed" value="true"> Personal experience is distinguished from professional advice.</label>
                  <label class="admin-inline"><input type="checkbox" name="healthSourcesConfirmed" value="true"> Factual health claims use appropriate authoritative sources where applicable.</label>
                  <label class="admin-inline"><input type="checkbox" name="healthSafetyConfirmed" value="true"> The post avoids diagnosis, individual treatment, guarantees, dangerous restriction, and advice to ignore serious symptoms.</label>
                  <label class="admin-inline"><input type="checkbox" name="healthCredentialsConfirmed" value="true"> Credentials and emergency guidance are represented responsibly.</label>
                </fieldset>
              <% if (publicationOverrideFlags.length) { %>
                <label class="moderation-reject-label" for="moderationOverrideReason">Required moderation override</label>
                <p class="admin-field-help">Active flags: <%= publicationOverrideFlags.join(', ') %>. Reject confirmed violations. Approve only when these signals are false positives or the use is demonstrably authorized.</p>
                <textarea id="moderationOverrideReason" name="overrideReason" required minlength="20" maxlength="500" rows="4" placeholder="Explain why approval is appropriate despite these signals."></textarea>
              <% } %>
              <fieldset class="moderation-health-checks">
                <legend>Search indexing review</legend>
                <label>Content risk
                  <select name="contentRisk" required>
                    <option value="general" <%= post.contentRisk !== 'health_safety' ? 'selected' : '' %>>General</option>
                    <option value="health_safety" <%= post.contentRisk === 'health_safety' ? 'selected' : '' %>>Health or safety guidance</option>
                  </select>
                </label>
                <label class="admin-inline"><input type="checkbox" name="searchIndexingApproved" value="true"> Approve this article for search indexing and public discovery.</label>
                <label>Value basis
                  <select name="valueBasis">
                    <option value="">Select when indexing is approved</option>
                    <option value="first_party_platform">First-party HelloRun platform knowledge</option>
                    <option value="original_reporting">Original reporting</option>
                    <option value="documented_experience">Documented experience</option>
                    <option value="qualified_expert_review">Qualified expert review</option>
                  </select>
                </label>
                <label>Evidence note<textarea name="evidenceNote" minlength="40" maxlength="1000" rows="3" placeholder="Explain the first-party evidence, reporting, or documented experience that makes this page distinct."></textarea></label>
                <p class="admin-field-help">Health or safety guidance remains noindex unless all qualified-reviewer fields below are complete.</p>
                <label>Expert reviewer name<input name="expertReviewerName" type="text" maxlength="160"></label>
                <label>Credentials<input name="expertReviewerCredentials" type="text" maxlength="240"></label>
                <label>Organization<input name="expertReviewerOrganization" type="text" maxlength="200"></label>
                <label>Public profile URL<input name="expertReviewerProfileUrl" type="url" maxlength="2000"></label>
                <label>Expert review date<input name="expertReviewedAt" type="date"></label>
              </fieldset>
              <fieldset class="moderation-health-checks"><legend>Publication timing</legend><label class="admin-inline"><input type="radio" name="publicationMode" value="now" checked> Publish now</label><label class="admin-inline"><input type="radio" name="publicationMode" value="scheduled"> Schedule</label><label id="scheduledForWrap" hidden>Publish date and time<input id="scheduledForLocal" type="datetime-local"><input id="scheduledFor" type="hidden" name="scheduledFor"></label></fieldset>
              <button type="submit" class="mod-btn mod-btn-approve" data-loading-text="Publishing..." onclick="return confirm('Approve this post for publication?');">Approve Publication</button>
            </form>
          </section>
          <section class="mod-card mod-card-danger js-pending-actions">
            <h4>Reject with Feedback</h4>
            <p>The author will see this feedback and can revise the post.</p>
            <form method="POST" action="/admin/blog/posts/<%= post._id %>/reject-form" class="moderation-reject-form">
              <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
              <label class="moderation-reject-label" for="rejectionReason">Rejection reason</label>
              <select id="rejectionTemplate"><option value="">Choose a feedback template (optional)</option><option>The post is not clearly related to running or HelloRun.</option><option>The post needs clearer structure and more useful details.</option><option>The post contains unsupported health or medical claims.</option><option>The post appears promotional without enough reader value.</option><option>The post may contain copyrighted or copied content.</option><option>The post needs grammar, clarity, or formatting improvements.</option></select>
              <textarea id="rejectionReason" name="rejectionReason" required minlength="15" maxlength="500" placeholder="Explain what should be fixed before this can be approved." class="moderation-reason-input" data-count-target="rejectionReasonCounter" data-minlength="15"></textarea>
              <div class="moderation-field-footer">
                <span id="rejectionReasonHint">Minimum 15 characters required.</span>
                <span id="rejectionReasonCounter" aria-live="polite">0/500</span>
              </div>
              <button type="submit" class="mod-btn mod-btn-reject" data-loading-text="Rejecting..." onclick="return confirm('Reject this post?');">Reject</button>
            </form>
          </section>
        <% } %>

        <% if (['published', 'scheduled'].includes(post.status)) { %>
          <section class="mod-card mod-card-danger js-published-actions" style="grid-column: 1 / -1;">
            <h4>Danger Zone</h4>
            <p>Archiving removes this post from public listing.</p>
            <form method="POST" action="/admin/blog/posts/<%= post._id %>/archive-form">
              <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
              <button type="submit" class="mod-btn mod-btn-archive" data-loading-text="Archiving..." onclick="return confirm('Archive this published post?');">Archive</button>
            </form>
          </section>
        <% } %>
        <% if (post.status === 'archived') { %><section class="mod-card"><h4>Restore for editing</h4><p>Restoring moves this post to draft. It must pass review before becoming public again.</p><form method="POST" action="/admin/blog/posts/<%= post._id %>/restore"><input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>"><button class="mod-btn" type="submit">Restore to Draft</button></form></section><% } %>
        <% if (post.status === 'draft') { %><section class="mod-card"><h4>Submit for review</h4><p>Validate this draft and move it into the moderation queue.</p><form method="POST" action="/admin/blog/posts/<%= post._id %>/submit-review"><input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>"><button class="mod-btn" type="submit">Submit for Review</button></form></section><% } %>
        <section class="mod-card"><h4>Homepage curation</h4><p>Feature or unfeature this post without changing its publication state.</p><form method="POST" action="/admin/blog/posts/<%= post._id %>/<%= post.featured ? 'unfeature' : 'feature' %>"><input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>"><button class="mod-btn" type="submit"><%= post.featured ? 'Remove Featured Status' : 'Feature Post' %></button></form></section>
      </div>
    </section>

    <section class="history-panel" aria-labelledby="history-title">
      <h3 id="history-title" class="history-title">Change History</h3>
      <p class="history-note">Tracks admin auto-save edits for this post.</p>
      <% if (!revisions || revisions.length === 0) { %>
        <p class="history-empty">No revision records yet.</p>
      <% } else { %>
        <div class="history-list">
          <% revisions.forEach((revision) => { %>
            <article class="history-item">
              <div class="history-item-head">
                <p class="history-meta">
                  <%= revision.editedBy?.firstName || 'Admin' %> <%= revision.editedBy?.lastName || '' %>
                  (<%= revision.editedBy?.email || 'unknown' %>) •
                  <%= new Date(revision.editedAt || revision.createdAt).toLocaleString() %>
                </p>
              </div>
              <p class="history-fields">
                <span class="blog-admin-badge"><%= revision.source || 'unknown' %></span>
                <% if (revision.status) { %><span class="blog-admin-badge <%= revision.status %>"><%= revision.status %></span><% } %>
                Changed: <%= (revision.changedFields || []).length ? revision.changedFields.join(', ') : 'none' %>
              </p>
              <% if (revision.before && revision.after && (revision.changedFields || []).length) { %>
                <details class="history-details">
                  <summary>View details</summary>
                  <div class="history-diff"><% (revision.changedFields || []).forEach((field) => { %><div class="history-diff-card"><h5><%= field %></h5><p><strong>Before</strong></p><pre><%= typeof revision.before?.[field] === 'string' ? revision.before[field] : JSON.stringify(revision.before?.[field], null, 2) %></pre><p><strong>After</strong></p><pre><%= typeof revision.after?.[field] === 'string' ? revision.after[field] : JSON.stringify(revision.after?.[field], null, 2) %></pre></div><% }) %></div>
                </details>
              <% } %>
            </article>
          <% }) %>
        </div>
      <% } %>
      <% if (historyPagination.totalPages > 1) { %><nav class="blog-admin-pagination"><% if (historyPagination.page > 1) { %><a class="btn btn-secondary" href="?historyPage=<%= historyPagination.page - 1 %>#history-title">Previous</a><% } %><span>History page <%= historyPagination.page %> of <%= historyPagination.totalPages %></span><% if (historyPagination.page < historyPagination.totalPages) { %><a class="btn btn-secondary" href="?historyPage=<%= historyPagination.page + 1 %>#history-title">Next</a><% } %></nav><% } %>
    </section>
  </main>
  <%- include('../layouts/footer') %>
  <script src="/js/main.js"></script>
  <script id="adminBlogReviewConfig" type="application/json"><%- JSON.stringify({ status: post.status, contentVersion: Number(sourcePost.contentVersion || 0), editVersion: reviewTarget?.revision ? Number(reviewTarget.revision.editVersion || 0) : null, templateBlocksByKey: templateBlocksByKey || {}, blockLabels: (blockTypes || []).reduce((acc, item) => { acc[item.key] = item.label; return acc; }, {}), contentBlocks: post.contentBlocks || [], autosaveUrl: `/admin/blog/posts/${post._id}/autosave`, csrfToken: locals.csrfToken || '', featured: Boolean(post.featured) }).replace(/</g, '\\u003c') %></script>
  <script src="/js/admin-blog-review.js"></script>
  <script>if(window.lucide) lucide.createIcons();</script>
</body>
</html>
