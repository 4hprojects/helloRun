# Core application
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
SESSION_SECRET=
MONGODB_URI=
DATABASE_URL=

# Private Strava connected-app viewer
# Keep false until production configuration, remediation, policies, webhook
# subscription, and supervised smoke checks are complete.
STRAVA_PRIVATE_VIEWER_ENABLED=false
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:3000/integrations/strava/callback
# 32 bytes encoded as 64 hexadecimal characters or base64.
STRAVA_ENCRYPTION_KEY=
STRAVA_WEBHOOK_VERIFY_TOKEN=
# Optional override; defaults to APP_URL + /api/integrations/strava/webhook.
STRAVA_WEBHOOK_CALLBACK_URL=
STRAVA_LIFECYCLE_WORKER_INTERVAL_MS=60000

# Reserved for a future direct COROS integration. Keep false until Partner API
# credentials, terms, and written approval have been reviewed and documented.
COROS_DIRECT_INTEGRATION_ENABLED=false

# Remediation apply guardrails. Copy the count and fingerprint from a reviewed dry run.
STRAVA_REMEDIATION_APPROVED=no
STRAVA_REMEDIATION_APPROVED_COUNT=
STRAVA_REMEDIATION_TARGET_FINGERPRINT=

# Shared rate limiting and lifecycle workers
REDIS_URL=

# Email
RESEND_API_KEY=
EMAIL_FROM=

# Cloudflare R2 (required before applying the Strava remediation migration)
CLOUDFLARE_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=

# Platform-aware OCR (docs/improvement-plan/ocr-platform-aware). Every flag defaults to off.
# Server re-read of stored run proofs, and auto-approval from that reading only.
OCR_SERVER_PIPELINE_ENABLED=false
OCR_SERVER_AUTO_APPROVAL_ENABLED=false
# inline = worker inside the web process; separate = run `npm run ocr:worker` under its own PM2 process.
OCR_WORKER_MODE=inline
# Optional bucket with no public domain for OCR crops, model artifacts and logs (defaults to R2_BUCKET).
OCR_R2_BUCKET=
# Resource limits (defaults shown).
OCR_MAX_INPUT_PIXELS=40000000
OCR_MAX_PROOF_BYTES=10485760
OCR_WORKING_MAX_DIMENSION=1600
OCR_MAX_PASSES=3
OCR_RECOGNITION_TIMEOUT_MS=45000
OCR_JOB_TIMEOUT_MS=120000
OCR_WORKER_RECYCLE_AFTER_JOBS=50
OCR_WORKER_IDLE_MS=300000
OCR_WORKER_INTERVAL_MS=15000
OCR_WORKER_JOBS_PER_CYCLE=3
OCR_JOB_LEASE_MS=300000
OCR_JOB_MAX_ATTEMPTS=3
# Optional activity link on run-proof submissions (format check + reviewer manual check; the server never fetches it).
ACTIVITY_URL_ENABLED=false
# Show the opt-in checkbox for using cropped text lines to improve OCR. Publish the matching privacy-policy wording first.
OCR_TRAINING_CONSENT_PROMPT_ENABLED=false
# Manual OCR training (separate process: `npm run ocr:training-worker`). Activation is always a separate admin action.
OCR_TRAINING_ENABLED=false
OCR_TESSTRAIN_DIR=/opt/tesstrain
OCR_TRAINING_TESSDATA_DIR=/opt/tessdata_best
OCR_TRAINING_WORK_DIR=
# Local cache for checksum-verified activated models (defaults to the OS temp dir).
OCR_MODEL_CACHE_DIR=
