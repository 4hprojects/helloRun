# Copy to .env.development. These endpoints are bound to loopback by
# compose.dev.yml and must never be replaced with production credentials.
NODE_ENV=development
TRUST_CLOUDFLARE_IP_HEADER=0
PORT=3001
APP_URL=http://localhost:3001
SESSION_SECRET=local-development-only-change-me-32-chars
MONGODB_URI=mongodb://127.0.0.1:27018/hellorun_dev?replicaSet=rs0&directConnection=true
DATABASE_URL=postgres://hellorun_dev:hellorun_dev_local_only@127.0.0.1:5433/hellorun_dev
REDIS_URL=

# Keep external effects and unfinished features disabled in the isolated tier.
RESEND_API_KEY=
EMAIL_FROM=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=
FEATURE_STEP_COMPETITIONS_ENABLED=false
STRAVA_PRIVATE_VIEWER_ENABLED=false
COROS_DIRECT_INTEGRATION_ENABLED=false
OCR_SERVER_PIPELINE_ENABLED=false
OCR_SERVER_AUTO_APPROVAL_ENABLED=false
OCR_TRAINING_CONSENT_PROMPT_ENABLED=false
OCR_TRAINING_ENABLED=false
OCR_REMINDERS_ENABLED=false
